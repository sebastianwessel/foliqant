  "required": [
    "rawRecords",
    "eligibleRecords",
    "selectedRecords",
    "selectedFamilies",
    "sourceCounts",
    "selectedSourceCounts",
    "eligibleLanguageCounts",
    "selectedLanguageCounts",
    "eligibleSplitCounts",
    "selectedSplitCounts",
    "familyCounts",
    "questionTypeCounts",
    "selectedQuestionTypeCounts",
    "exclusionCounts"
  ],
  "title": "ProjectionReport",
  "type": "object"
}

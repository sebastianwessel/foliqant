{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "dataset",
        "checkpoint",
        "quantized",
        "adapter",
        "merged",
        "export",
        "evaluation",
        "policy",
        "audit"
      ],
      "type": "string"
    },
    "AuditResult": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/CreatedArtifactResult"
        },
        "command": {
          "const": "audit",
          "title": "Command",
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/RiskSampleSummary"
        },
        "coverage": {
          "ge": 0,
          "le": 1,
          "title": "Coverage",
          "type": "number"
        },
        "status": {
          "enum": [
            "insufficient",
            "meets-bound",
            "fails-bound"
          ],
          "title": "Status",
          "type": "string"
        },
        "upperErrorBound": {
          "anyOf": [
            {
              "ge": 0,
              "le": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uppererrorbound"
        }
      },
      "required": [
        "command",
        "artifact",
        "status",
        "counts",
        "coverage",
        "upperErrorBound"
      ],
      "title": "AuditResult",
      "type": "object"
    },
    "AuditSuccess": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "audit",
          "title": "Command",
          "type": "string"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "result": {
          "$ref": "#/$defs/AuditResult"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "ok",
        "command",
        "result"
      ],
      "title": "AuditSuccess",
      "type": "object"
    },

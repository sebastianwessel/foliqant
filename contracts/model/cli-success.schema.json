    "CreatedArtifactResult": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifactid",
          "type": "string"
        },
        "customer": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Customer"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "outputPath": {
          "title": "Outputpath",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        }
      },
      "required": [
        "outputPath",
        "artifactId",
        "kind",
        "stage",
        "customer"
      ],

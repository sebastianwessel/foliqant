    "CountRate": {
      "additionalProperties": false,
      "properties": {
        "eligibleCount": {
          "minimum": 0,
          "title": "Eligiblecount",
          "type": "integer"
        },
        "passedCount": {
          "minimum": 0,
          "title": "Passedcount",
          "type": "integer"
        },
        "rate": {
          "anyOf": [
            {
              "ge": 0,
              "le": 1,
              "type": "number"
            },

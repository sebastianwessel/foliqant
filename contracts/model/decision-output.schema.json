{
  "$defs": {
    "Answerability": {
      "additionalProperties": false,
      "properties": {
        "issues": {
          "items": {
            "$ref": "#/$defs/AnswerabilityIssue"
          },
          "maxItems": 32,
          "title": "Issues",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/AnswerabilityStatus"
        }
      },
      "required": [
        "status",
        "issues"
      ],
      "title": "Answerability",
      "type": "object"
    },
    "AnswerabilityIssue": {
      "enum": [
        "missing_information",
        "conflicting_information",
        "multiple_valid_options",
        "no_matching_option"
      ],
      "type": "string"
    },
    "AnswerabilityStatus": {
      "enum": [
        "answerable",
        "partially_answerable",
        "not_answerable",
        "undetermined"
      ],
      "type": "string"
    },
    "ChoiceAnswer": {
      "additionalProperties": false,
      "properties": {
        "optionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Optionid",
          "type": "string"
        }
      },
      "required": [
        "optionId"
      ],
      "title": "ChoiceAnswer",
      "type": "object"
    },
    "ChoiceResult": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChoiceAnswer"
            },
            {
              "type": "null"
            }
          ]
        },
        "answerability": {
          "$ref": "#/$defs/Answerability"
        },
        "explanation": {
          "$ref": "#/$defs/Explanation"
        },
        "questionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Questionid",
          "type": "string"
        },
        "type": {
          "const": "choice",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "questionId",
        "answerability",
        "explanation",
        "type",
        "answer"
      ],
      "title": "ChoiceResult",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "sourceId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Sourceid",
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ConditionalRelation": {
      "additionalProperties": false,
      "properties": {
        "predicateQuestionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Predicatequestionid",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Requestid",
          "type": "string"
        },
        "requiredValue": {
          "enum": [
            "true",
            "false"
          ],
          "title": "Requiredvalue",
          "type": "string"
        },
        "type": {
          "const": "conditional_on",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "predicateQuestionId",
        "requiredValue"
      ],
      "title": "ConditionalRelation",
      "type": "object"
    },
    "DecisionResult": {
      "discriminator": {
        "mapping": {
          "choice": "#/$defs/ChoiceResult",
          "multiselect": "#/$defs/MultiselectResult",
          "ordinal": "#/$defs/OrdinalResult",
          "predicate": "#/$defs/PredicateResult",
          "request_units": "#/$defs/RequestUnitsResult"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ChoiceResult"
        },
        {
          "$ref": "#/$defs/MultiselectResult"
        },
        {
          "$ref": "#/$defs/PredicateResult"
        },
        {
          "$ref": "#/$defs/OrdinalResult"
        },
        {
          "$ref": "#/$defs/RequestUnitsResult"
        }
      ]
    },
    "Explanation": {
      "additionalProperties": false,
      "properties": {
        "contraryEvidence": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 256,
          "title": "Contraryevidence",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 256,
          "title": "Evidence",
          "type": "array"
        },
        "missingFacts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "title": "Missingfacts",
          "type": "array"
        },
        "summary": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "evidence",
        "contraryEvidence",
        "missingFacts"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "MultiselectAnswer": {
      "additionalProperties": false,
      "properties": {
        "optionIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Optionids",
          "type": "array"
        }
      },
      "required": [
        "optionIds"
      ],
      "title": "MultiselectAnswer",
      "type": "object"
    },
    "MultiselectResult": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/MultiselectAnswer"
            },
            {
              "type": "null"
            }
          ]
        },
        "answerability": {
          "$ref": "#/$defs/Answerability"
        },
        "explanation": {
          "$ref": "#/$defs/Explanation"
        },
        "questionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Questionid",
          "type": "string"
        },
        "type": {
          "const": "multiselect",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "questionId",
        "answerability",
        "explanation",
        "type",
        "answer"
      ],
      "title": "MultiselectResult",
      "type": "object"
    },
    "MutuallyExclusiveRelation": {
      "additionalProperties": false,
      "properties": {
        "requestIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Requestids",
          "type": "array"
        },
        "type": {
          "const": "mutually_exclusive",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestIds"
      ],
      "title": "MutuallyExclusiveRelation",
      "type": "object"
    },
    "OrdinalAnswer": {
      "additionalProperties": false,
      "properties": {
        "levelId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Levelid",
          "type": "string"
        }
      },
      "required": [
        "levelId"
      ],
      "title": "OrdinalAnswer",
      "type": "object"
    },
    "OrdinalResult": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrdinalAnswer"
            },
            {
              "type": "null"
            }
          ]
        },
        "answerability": {
          "$ref": "#/$defs/Answerability"
        },
        "explanation": {
          "$ref": "#/$defs/Explanation"
        },
        "questionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Questionid",
          "type": "string"
        },
        "type": {
          "const": "ordinal",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "questionId",
        "answerability",
        "explanation",
        "type",
        "answer"
      ],
      "title": "OrdinalResult",
      "type": "object"
    },
    "PrecedesRelation": {
      "additionalProperties": false,
      "properties": {
        "afterRequestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Afterrequestid",
          "type": "string"
        },
        "beforeRequestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Beforerequestid",
          "type": "string"
        },
        "type": {
          "const": "precedes",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "beforeRequestId",
        "afterRequestId"
      ],
      "title": "PrecedesRelation",
      "type": "object"
    },
    "PredicateAnswer": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "true",
            "false",
            "unknown"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "PredicateAnswer",
      "type": "object"
    },
    "PredicateResult": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "$ref": "#/$defs/PredicateAnswer"
        },
        "answerability": {
          "$ref": "#/$defs/Answerability"
        },
        "explanation": {
          "$ref": "#/$defs/Explanation"
        },
        "questionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Questionid",
          "type": "string"
        },
        "type": {
          "const": "predicate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "questionId",
        "answerability",
        "explanation",
        "type",
        "answer"
      ],
      "title": "PredicateResult",
      "type": "object"
    },
    "RequestRelation": {
      "discriminator": {
        "mapping": {
          "conditional_on": "#/$defs/ConditionalRelation",
          "mutually_exclusive": "#/$defs/MutuallyExclusiveRelation",
          "precedes": "#/$defs/PrecedesRelation",
          "requires": "#/$defs/RequiresRelation"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ConditionalRelation"
        },
        {
          "$ref": "#/$defs/RequiresRelation"
        },
        {
          "$ref": "#/$defs/PrecedesRelation"
        },
        {
          "$ref": "#/$defs/MutuallyExclusiveRelation"
        }
      ]
    },
    "RequestUnit": {
      "additionalProperties": false,
      "properties": {
        "categoryId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Categoryid"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "withdrawn",
            "conditional",
            "quoted"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject"
        }
      },
      "required": [
        "id",
        "status",
        "categoryId",
        "subject",
        "description",
        "evidence"
      ],
      "title": "RequestUnit",
      "type": "object"
    },
    "RequestUnitsAnswer": {
      "additionalProperties": false,
      "properties": {
        "relations": {
          "items": {
            "$ref": "#/$defs/RequestRelation"
          },
          "maxItems": 256,
          "title": "Relations",
          "type": "array"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/RequestUnit"
          },
          "maxItems": 256,
          "title": "Units",
          "type": "array"
        }
      },
      "required": [
        "units",
        "relations"
      ],
      "title": "RequestUnitsAnswer",
      "type": "object"
    },
    "RequestUnitsResult": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestUnitsAnswer"
            },
            {
              "type": "null"
            }
          ]
        },
        "answerability": {
          "$ref": "#/$defs/Answerability"
        },
        "explanation": {
          "$ref": "#/$defs/Explanation"
        },
        "questionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Questionid",
          "type": "string"
        },
        "type": {
          "const": "request_units",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "questionId",
        "answerability",
        "explanation",
        "type",
        "answer"
      ],
      "title": "RequestUnitsResult",
      "type": "object"
    },
    "RequiresRelation": {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Requestid",
          "type": "string"
        },
        "requiredRequestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Requiredrequestid",
          "type": "string"
        },
        "type": {
          "const": "requires",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "requiredRequestId"
      ],
      "title": "RequiresRelation",
      "type": "object"
    }
  },
  "$id": "https://foliqant.local/contracts/model/decision-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "results": {
      "items": {
        "$ref": "#/$defs/DecisionResult"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Results",
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "default": 1,
      "title": "Schemaversion",
      "type": "integer"
    }
  },
  "required": [
    "results"
  ],
  "title": "DecisionOutput",
  "type": "object"
}

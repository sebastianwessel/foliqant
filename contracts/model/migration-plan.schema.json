{
  "$defs": {
    "ChatMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "CurationConfig": {
      "additionalProperties": false,
      "description": "Complete recipe for the source corpus and local augmentation workflow.",
      "properties": {
        "decisionData": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionDataSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "endpoint": {
          "$ref": "#/$defs/LocalEndpointConfig"
        },
        "generation": {
          "$ref": "#/$defs/GenerationSettings"
        },
        "name": {
          "default": "financial-decisions-en-v1",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "seed": {
          "default": 42,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceSelection"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "title": "CurationConfig",
      "type": "object"
    },
    "DataRecord": {
      "additionalProperties": false,
      "properties": {
        "familyId": {
          "$ref": "#/$defs/foliqant_model__contracts__base__Omitted_Annotated_str__StringConstraints____1",
          "default": null
        },
        "generation": {
          "$ref": "#/$defs/Omitted_GenerationProvenance_",
          "default": null
        },
        "groupKeys": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Groupkeys",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "language": {
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
          "title": "Language",
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "maxItems": 256,
          "minItems": 2,
          "title": "Messages",
          "type": "array"
        },
        "origin": {
          "enum": [
            "human",
            "synthetic",
            "teacher"
          ],
          "title": "Origin",
          "type": "string"
        },
        "reviewed": {
          "title": "Reviewed",
          "type": "boolean"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "sourceId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Sourceid",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "sourceId",
        "language",
        "groupKeys",
        "messages",
        "origin",
        "reviewed"
      ],
      "title": "DataRecord",
      "type": "object"
    },
    "DecisionDataSettings": {
      "additionalProperties": false,
      "description": "Bounded native decision-data generation settings.",
      "properties": {
        "examplesPerScenario": {
          "default": 4,
          "maximum": 10000,
          "minimum": 4,
          "title": "Examplesperscenario",
          "type": "integer"
        },
        "minimumAcceptedPerCell": {
          "default": 1,
          "maximum": 1000,
          "minimum": 0,
          "title": "Minimumacceptedpercell",
          "type": "integer"
        },
        "sourceExamplesPerSource": {
          "default": 100,
          "maximum": 100000,
          "minimum": 0,
          "title": "Sourceexamplespersource",
          "type": "integer"
        }
      },
      "title": "DecisionDataSettings",
      "type": "object"
    },
    "DecisionSeed": {
      "additionalProperties": false,
      "description": "One native parent whose final two messages contain the input and oracle.",
      "properties": {
        "mode": {
          "enum": [
            "rewrite",
            "annotate"
          ],
          "title": "Mode",
          "type": "string"
        },
        "parent": {
          "$ref": "#/$defs/DataRecord"
        },
        "rewriteSourceIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },

          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Modelidentitysha256",
          "type": "string"
        },
        "modelWeightsSha256": {
          "$ref": "#/$defs/foliqant_model__contracts__base__Omitted_Annotated_str__StringConstraints____2",
          "default": null
        },
        "parametersSha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parameterssha256",
          "type": "string"
        },
        "parentRecordIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Parentrecordids",
          "type": "array"
        },
        "promptSha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Promptsha256",
          "type": "string"

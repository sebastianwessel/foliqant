          "type": "array"
        }
      },
      "title": "GenerationSettings",
      "type": "object"
    },
    "LocalEndpointConfig": {
      "additionalProperties": false,
      "description": "Validated location and limits for one trusted generation endpoint.\n\nThe default permits only a loopback endpoint.  A numeric RFC1918 or IPv6\nunique-local address requires the explicit ``allowPrivateNetwork`` opt-in;\npublic addresses, DNS names, credentials, redirects and proxies remain\nunsupported.",
      "properties": {
        "allowPrivateNetwork": {
          "default": false,
          "title": "Allowprivatenetwork",
          "type": "boolean"
        },
        "baseUrl": {
          "default": "http://127.0.0.1:1234/v1",
          "minLength": 1,
          "title": "Baseurl",
          "type": "string"
        },
        "maxResponseBytes": {
          "default": 8388608,
          "maximum": 16777216,
          "minimum": 1024,
          "title": "Maxresponsebytes",
          "type": "integer"
        },
        "maxTokens": {
          "default": 2048,
          "maximum": 32768,
          "minimum": 1,
          "title": "Maxtokens",
          "type": "integer"
        },
        "model": {
          "$ref": "#/$defs/Omitted_Annotated_str__StringConstraints__AfterValidator__",
          "default": null
        },
        "reasoningEffort": {
          "$ref": "#/$defs/Omitted_Literal__low____medium____xhigh___",
          "default": null
        },
        "structuredOutput": {
          "default": "json-schema",
          "enum": [
            "json-schema",
            "prompt"
          ],
          "title": "Structuredoutput",
          "type": "string"
        },
        "temperature": {
          "default": 0.3,
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "timeoutSeconds": {
          "default": 120,
          "maximum": 600,
          "minimum": 1,
          "title": "Timeoutseconds",
          "type": "integer"
        }
      },
      "title": "LocalEndpointConfig",
      "type": "object"
    },
    "MigrationEntry": {
      "additionalProperties": false,

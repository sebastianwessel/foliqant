          "type": "string"
        },
        "requestSha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Requestsha256",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "modelId",
        "modelIdentitySha256",
        "promptSha256",
        "parametersSha256",
        "requestSha256",
        "parentRecordIds"
      ],
      "title": "GenerationProvenance",
      "type": "object"
    },
    "GenerationSettings": {
      "additionalProperties": false,
      "description": "Explicit bounded generation; quarantine never becomes human review.",
      "properties": {
        "languages": {
          "items": {
            "enum": [
              "en",
              "de"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Languages",
          "type": "array"
        },
        "maxAttempts": {
          "default": 2,
          "maximum": 5,
          "minimum": 1,
          "title": "Maxattempts",
          "type": "integer"
        },
        "maxCandidates": {
          "default": 100,
          "maximum": 100000,
          "minimum": 1,
          "title": "Maxcandidates",
          "type": "integer"
        },
        "maxInputCharacters": {
          "default": 16000,
          "maximum": 131072,
          "minimum": 256,
          "title": "Maxinputcharacters",
          "type": "integer"
        },
        "scenarioFamilies": {
          "default": 20,
          "maximum": 10000,
          "minimum": 4,
          "title": "Scenariofamilies",
          "type": "integer"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/Scenario"

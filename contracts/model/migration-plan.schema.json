      "required": [
        "parent",
        "scenario",
        "mode",
        "rewriteSourceIds"
      ],
      "title": "DecisionSeed",
      "type": "object"
    },
    "EndpointModelIdentity": {
      "additionalProperties": false,
      "description": "Runtime-observed model identity; it is not a verified weight revision.",
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Architecture"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "gguf",
                "mlx"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Format"
        },
        "immutableRevision": {
          "default": null,
          "title": "Immutablerevision",
          "type": "null"
        },
        "maxContextLength": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maxcontextlength"
        },
        "metadataSha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metadatasha256",
          "type": "string"
        },
        "modelId": {
          "minLength": 1,
          "title": "Modelid",
          "type": "string"
        },
        "modelType": {
          "enum": [
            "llm",
            "embedding",
            "unknown"
          ],
          "title": "Modeltype",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Publisher"
        },
        "quantization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantization"
        },
        "sizeBytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }

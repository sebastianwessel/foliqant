      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "DataRecord": {
      "additionalProperties": false,
      "properties": {
        "familyId": {
          "$ref": "#/$defs/foliqant_model__contracts__base__Omitted_Annotated_str__StringConstraints____1",
          "default": null
        },
        "generation": {
          "$ref": "#/$defs/Omitted_GenerationProvenance_",
          "default": null

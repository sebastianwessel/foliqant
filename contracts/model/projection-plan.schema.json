          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "language": {
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
          "title": "Language",
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "maxItems": 256,
          "minItems": 2,
          "title": "Messages",
          "type": "array"
        },
        "origin": {
          "enum": [
            "human",
            "synthetic",
            "teacher"
          ],
          "title": "Origin",
          "type": "string"
        },
        "reviewed": {
          "title": "Reviewed",
          "type": "boolean"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "sourceId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Sourceid",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "sourceId",
        "language",
        "groupKeys",
        "messages",
        "origin",
        "reviewed"
      ],
      "title": "DataRecord",
      "type": "object"
    },
    "DecisionSeed": {
      "additionalProperties": false,
      "description": "One native parent whose final two messages contain the input and oracle.",

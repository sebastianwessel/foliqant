  "$id": "https://foliqant.local/contracts/model/projection-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "New native seeds derived offline from one immutable curation snapshot.",
  "properties": {
    "configSha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configsha256",
      "type": "string"
    },
    "frozenFamilies": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
          "$ref": "#/$defs/FrozenFamilyAssignment"
        }
      },
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Frozenfamilies",
      "type": "object"
    },
    "parentInputsSha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Parentinputssha256",
      "type": "string"
    },
    "parentRun": {
      "title": "Parentrun",
      "type": "string"
    },
    "projectionVersion": {
      "minLength": 1,
      "title": "Projectionversion",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/ProjectionReport"
    },
    "schemaVersion": {
      "const": 1,
      "default": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "seeds": {
      "items": {
        "$ref": "#/$defs/DecisionSeed"
      },
      "title": "Seeds",
      "type": "array"
    },
    "selection": {
      "enum": [
        "full",
        "pilot"
      ],
      "title": "Selection",
      "type": "string"
    },
    "sourcePlanSha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sourceplansha256",
      "type": "string"
    },
    "sourceSnapshots": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Sourcesnapshots",
      "type": "object"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/ResolvedSourceDeclaration"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "projectionVersion",
    "selection",
    "parentInputsSha256",
    "sourcePlanSha256",
    "configSha256",
    "parentRun",
    "sourceSnapshots",
    "seeds",
    "frozenFamilies",
    "sources",
    "report"
  ],
  "title": "ProjectionPlan",
  "type": "object"
}

        "promptSha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Promptsha256",
          "type": "string"
        },
        "provider": {
          "const": "openai-compatible",
          "title": "Provider",
          "type": "string"
        },
        "requestSha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Requestsha256",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "modelId",
        "modelIdentitySha256",
        "promptSha256",
        "parametersSha256",
        "requestSha256",
        "parentRecordIds"
      ],

{
  "$defs": {
    "SetupAsset": {
      "additionalProperties": false,
      "description": "One exact remote file, verified before entering the local cache.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "path",
        "url",
        "size",
        "sha256"
      ],
      "title": "SetupAsset",
      "type": "object"
    }
  },
  "$id": "https://foliqant.local/contracts/model/setup-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The built-in, immutable diagnostic setup recipe.",
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/SetupAsset"
      },
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "converter": {
      "const": "banking77-smoke-v1",
      "title": "Converter",
      "type": "string"
    },
    "datasetLicense": {
      "minLength": 1,
      "title": "Datasetlicense",
      "type": "string"
    },
    "datasetRepo": {
      "minLength": 1,
      "title": "Datasetrepo",
      "type": "string"
    },
    "datasetRevision": {
      "maxLength": 40,
      "minLength": 40,
      "pattern": "^[0-9a-f]{40}$",
      "title": "Datasetrevision",
      "type": "string"
    },
    "modelLicense": {
      "minLength": 1,
      "title": "Modellicense",
      "type": "string"
    },
    "modelRepo": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Modelrepo",
      "type": "string"
    },
    "modelRevision": {
      "maxLength": 40,
      "minLength": 40,
      "pattern": "^[0-9a-f]{40}$",
      "title": "Modelrevision",
      "type": "string"
    },
    "name": {
      "const": "smoke-v1",
      "title": "Name",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "modelRepo",
    "modelRevision",
    "modelLicense",
    "datasetRepo",
    "datasetRevision",
    "datasetLicense",
    "converter",
    "assets"
  ],
  "title": "SetupProfile",
  "type": "object"
}

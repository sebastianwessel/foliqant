{
  "$defs": {
    "FrozenFamilyAssignment": {
      "additionalProperties": false,
      "properties": {
        "sourceSplits": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Sourcesplits",
          "type": "array"
        },
        "split": {
          "$ref": "#/$defs/Split"
        }
      },
      "required": [
        "split",
        "sourceSplits"
      ],
      "title": "FrozenFamilyAssignment",
      "type": "object"
    },
    "Omitted_Annotated_str__StringConstraints__AfterValidator__": {
      "minLength": 1,
      "type": "string"
    },
    "Omitted_dict_Annotated_str__StringConstraints___FrozenFamilyAssignment__": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
          "$ref": "#/$defs/FrozenFamilyAssignment"
        }
      },
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "type": "object"
    },
    "SourceDeclaration": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "default": "",
          "title": "Attribution",
          "type": "string"
        },
        "authorizationRef": {
          "$ref": "#/$defs/Omitted_Annotated_str__StringConstraints__AfterValidator__",
          "default": null
        },
        "commercialUse": {
          "default": "unknown",
          "enum": [
            "allowed",
            "restricted",
            "unknown"
          ],
          "title": "Commercialuse",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "licenseEvidence": {
          "minLength": 1,
          "title": "Licenseevidence",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "privacy": {
          "enum": [
            "public",
            "private"
          ],
          "title": "Privacy",
          "type": "string"
        },
        "redistributionAllowed": {
          "title": "Redistributionallowed",
          "type": "boolean"
        },
        "restrictions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        },
        "sharedTrainingAllowed": {
          "default": false,
          "title": "Sharedtrainingallowed",
          "type": "boolean"
        },
        "trainingAllowed": {
          "const": true,
          "title": "Trainingallowed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "path",
        "license",
        "licenseEvidence",
        "trainingAllowed",
        "redistributionAllowed",
        "privacy"
      ],
      "title": "SourceDeclaration",
      "type": "object"
    },
    "Split": {
      "enum": [
        "train",
        "validation",
        "calibration",
        "test"
      ],
      "type": "string"
    }
  },
  "$id": "https://foliqant.local/contracts/model/dataset-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calibrationFraction": {
      "default": 0.1,
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0,
      "title": "Calibrationfraction",
      "type": "number"
    },
    "frozenFamilies": {
      "$ref": "#/$defs/Omitted_dict_Annotated_str__StringConstraints___FrozenFamilyAssignment__",
      "default": null,
      "description": "Complete source-family assignments frozen before augmentation; when present, these assignments override fraction-based preparation and the fractions remain planning hints"
    },
    "maxRecordBytes": {
      "default": 1048576,
      "maximum": 16777216,
      "minimum": 1,
      "title": "Maxrecordbytes",
      "type": "integer"
    },
    "maxRecords": {
      "default": 100000,
      "maximum": 1000000,
      "minimum": 4,
      "title": "Maxrecords",
      "type": "integer"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Name",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "seed": {
      "default": 42,
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceDeclaration"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "testFraction": {
      "default": 0.1,
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0,
      "title": "Testfraction",
      "type": "number"
    },
    "validationFraction": {
      "default": 0.1,
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0,
      "title": "Validationfraction",
      "type": "number"
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "sources"
  ],
  "title": "DatasetConfig",
  "type": "object"
}

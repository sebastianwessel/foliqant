  "$id": "https://foliqant.local/schemas/foliqant/decisions/decision-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "questions": {
      "items": {
        "$ref": "#/$defs/DecisionQuestion"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Questions",
      "type": "array"
    },
    "schemaVersion": {
      "const": 2,
      "default": 2,
      "title": "Schemaversion",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/DecisionState"
    }
  },
  "required": [
    "state",
    "questions"
  ],
  "title": "DecisionInput",
  "type": "object"
}

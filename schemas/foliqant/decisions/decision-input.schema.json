      "required": [
        "id",
        "prompt",
        "criteria",
        "allowedSourceIds",
        "type",
        "options",
        "minSelections",
        "maxSelections"
      ],
      "title": "MultiselectQuestion",
      "type": "object"
    },
    "OrdinalQuestion": {
      "additionalProperties": false,

        "allowedSourceIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Allowedsourceids",
          "type": "array"
        },
        "catalog": {
          "items": {
            "$ref": "#/$defs/DecisionOption"

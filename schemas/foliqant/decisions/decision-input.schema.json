          "title": "Id",
          "type": "string"
        },
        "maxSelections": {
          "maximum": 1024,
          "minimum": 1,
          "title": "Maxselections",
          "type": "integer"
        },
        "minSelections": {
          "maximum": 1024,
          "minimum": 0,
          "title": "Minselections",
          "type": "integer"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/DecisionOption"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Options",
          "type": "array"

{
  "$defs": {
    "ChoiceQuestion": {
      "additionalProperties": false,
      "properties": {
        "allowedSourceIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Allowedsourceids",
          "type": "array"
        },
        "criteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/DecisionOption"
          },
          "maxItems": 1024,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "type": {
          "const": "choice",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt",
        "criteria",
        "allowedSourceIds",
        "type",
        "options"
      ],
      "title": "ChoiceQuestion",
      "type": "object"
    },
    "DecisionOption": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "DecisionQuestion": {
      "discriminator": {
        "mapping": {
          "choice": "#/$defs/ChoiceQuestion",
          "multiselect": "#/$defs/MultiselectQuestion",
          "ordinal": "#/$defs/OrdinalQuestion",
          "predicate": "#/$defs/PredicateQuestion",
          "request_units": "#/$defs/RequestUnitsQuestion"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ChoiceQuestion"
        },
        {
          "$ref": "#/$defs/MultiselectQuestion"
        },
        {
          "$ref": "#/$defs/PredicateQuestion"
        },
        {
          "$ref": "#/$defs/OrdinalQuestion"
        },
        {
          "$ref": "#/$defs/RequestUnitsQuestion"
        }
      ]
    },
    "DecisionSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "message",
            "document",
            "table",
            "policy",
            "metadata"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "title": "DecisionSource",
      "type": "object"
    },
    "DecisionState": {
      "additionalProperties": false,
      "properties": {
        "sources": {
          "items": {
            "$ref": "#/$defs/DecisionSource"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "sources"
      ],
      "title": "DecisionState",
      "type": "object"
    },
    "MultiselectQuestion": {
      "additionalProperties": false,
      "properties": {
        "allowedSourceIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,

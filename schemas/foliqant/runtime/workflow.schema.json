{
  "$defs": {
    "CategoryCatalog": {
      "additionalProperties": false,
      "description": "A bounded classification catalog prepared before model inference.\n\nCategory keys are normalized deterministically and descriptions are\npreserved exactly. Unsupported external taxonomies require an explicit\nmapping before they enter this contract.",
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/CategoryDefinition"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Categories",
          "type": "array"
        }
      },
      "required": [
        "categories"
      ],
      "title": "CategoryCatalog",
      "type": "object"
    },
    "CategoryDefinition": {
      "additionalProperties": false,
      "description": "One stable machine key with caller-authored category semantics.",
      "properties": {
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "Printable ASCII authoring key. The Python CategoryCatalog parser serializes its deterministic lowercase snake_case normalization.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[\\x20-\\x7e]+$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "CategoryDefinition",
      "type": "object"
    },
    "ChoiceQuestion": {
      "additionalProperties": false,
      "properties": {
        "allowedSourceIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Allowedsourceids",
          "type": "array"
        },
        "criteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/DecisionOption"
          },
          "maxItems": 1024,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "type": {
          "const": "choice",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt",
        "criteria",
        "allowedSourceIds",
        "type",
        "options"
      ],
      "title": "ChoiceQuestion",
      "type": "object"
    },
    "ChoiceQuestionShorthand": {
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "$ref": "#/$defs/CategoryCatalog"
        },
        "criteria": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "type": {
          "const": "choice",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "criteria",
        "catalog"
      ],
      "title": "ChoiceQuestionShorthand",
      "type": "object"
    },
    "DecisionOption": {
      "additionalProperties": false,

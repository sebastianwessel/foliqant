      },
      "required": [
        "id",
        "description"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "DecisionQuestion": {
      "discriminator": {
        "mapping": {
          "choice": "#/$defs/ChoiceQuestion",
          "multiselect": "#/$defs/MultiselectQuestion",
          "ordinal": "#/$defs/OrdinalQuestion",
          "predicate": "#/$defs/PredicateQuestion",
          "request_units": "#/$defs/RequestUnitsQuestion"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ChoiceQuestion"
        },
        {
          "$ref": "#/$defs/MultiselectQuestion"
        },
        {
          "$ref": "#/$defs/PredicateQuestion"
        },
        {
          "$ref": "#/$defs/OrdinalQuestion"
        },
        {
          "$ref": "#/$defs/RequestUnitsQuestion"
        }
      ]
    },
    "DecisionStepAuthoring": {
      "additionalProperties": false,
      "properties": {
        "instructions": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Instructions",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "next": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next"
        },
        "on_answer": {
          "anyOf": [
            {
              "additionalProperties": {
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Answer"
        },
        "on_unresolved": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Unresolved"
        },
        "question": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "choice": "#/$defs/ChoiceQuestionShorthand",
                  "multiselect": "#/$defs/MultiselectQuestionShorthand",
                  "ordinal": "#/$defs/OrdinalQuestionShorthand",
                  "predicate": "#/$defs/PredicateQuestionShorthand",
                  "request_units": "#/$defs/RequestUnitsQuestionShorthand"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ChoiceQuestionShorthand"
                },
                {
                  "$ref": "#/$defs/MultiselectQuestionShorthand"
                },
                {
                  "$ref": "#/$defs/PredicateQuestionShorthand"
                },
                {
                  "$ref": "#/$defs/OrdinalQuestionShorthand"
                },
                {
                  "$ref": "#/$defs/RequestUnitsQuestionShorthand"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "questions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DecisionQuestion"
              },
              "maxItems": 64,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Questions"
        },
        "sources": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {
              "oneOf": [
                {
                  "$ref": "#/$defs/PointerBinding"
                },
                {
                  "$ref": "#/$defs/LiteralBinding"
                }
              ]
            }
          },
          "title": "Sources",
          "type": "object"
        },
        "type": {
          "const": "decision",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "sources",
        "instructions"
      ],
      "title": "DecisionStepAuthoring",
      "type": "object"
    },

{
  "$defs": {
    "AnthropicModelConfig": {
      "additionalProperties": false,
      "properties": {
        "api_key_env": {
          "default": "ANTHROPIC_API_KEY",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Api Key Env",
          "type": "string"
        },
        "concurrency": {
          "default": 4,
          "maximum": 1024,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Model",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/AnthropicOptions"
        },
        "output_mode": {
          "enum": [
            "native",
            "tool"
          ],
          "title": "Output Mode",
          "type": "string"
        },
        "provider": {
          "const": "anthropic",
          "title": "Provider",
          "type": "string"
        },
        "queue_limit": {
          "default": 16,
          "maximum": 10000,
          "minimum": 0,
          "title": "Queue Limit",
          "type": "integer"
        },
        "request_timeout": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Request Timeout",
          "type": "number"
        },
        "supports_json_schema": {
          "default": true,
          "title": "Supports Json Schema",
          "type": "boolean"
        },
        "supports_text": {
          "default": true,
          "title": "Supports Text",
          "type": "boolean"
        },
        "supports_tools": {
          "default": true,
          "title": "Supports Tools",
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "output_mode",
        "provider"
      ],
      "title": "AnthropicModelConfig",
      "type": "object"
    },
    "AnthropicOptions": {
      "additionalProperties": false,
      "properties": {
        "effort": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "max_tokens": {
          "default": 4096,
          "maximum": 1048576,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "thinking": {
          "anyOf": [
            {
              "enum": [
                "disabled",
                "adaptive"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking"
        },
        "thinking_budget": {
          "anyOf": [
            {
              "minimum": 1024,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Budget"
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "AnthropicOptions",
      "type": "object"
    },
    "AzureModelConfig": {
      "additionalProperties": false,
      "properties": {
        "api": {
          "enum": [
            "chat",
            "responses"
          ],
          "title": "Api",
          "type": "string"
        },
        "api_flavor": {
          "enum": [
            "versioned",
            "v1"
          ],
          "title": "Api Flavor",
          "type": "string"
        },
        "api_key_env": {
          "default": "AZURE_OPENAI_API_KEY",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Api Key Env",
          "type": "string"
        },
        "api_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Version"
        },
        "concurrency": {
          "default": 4,
          "maximum": 1024,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "endpoint": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Endpoint",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Model",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/OpenAIOptions"
        },
        "output_mode": {
          "enum": [
            "native",
            "tool"
          ],
          "title": "Output Mode",
          "type": "string"
        },
        "provider": {
          "const": "azure_openai",
          "title": "Provider",
          "type": "string"
        },
        "queue_limit": {
          "default": 16,
          "maximum": 10000,
          "minimum": 0,
          "title": "Queue Limit",
          "type": "integer"
        },
        "request_timeout": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Request Timeout",
          "type": "number"
        },
        "supports_json_schema": {
          "default": true,
          "title": "Supports Json Schema",
          "type": "boolean"
        },
        "supports_text": {
          "default": true,
          "title": "Supports Text",
          "type": "boolean"
        },
        "supports_tools": {
          "default": true,
          "title": "Supports Tools",
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "output_mode",
        "provider",
        "api",
        "api_flavor",
        "endpoint"
      ],
      "title": "AzureModelConfig",
      "type": "object"
    },
    "CompatibleModelConfig": {
      "additionalProperties": false,
      "properties": {
        "allow_insecure_http": {
          "default": false,
          "title": "Allow Insecure Http",
          "type": "boolean"
        },
        "api": {
          "const": "chat",
          "default": "chat",
          "title": "Api",
          "type": "string"
        },
        "api_key_env": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key Env"
        },
        "base_url": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Base Url",
          "type": "string"
        },
        "concurrency": {
          "default": 4,
          "maximum": 1024,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "max_tokens_field": {
          "default": "max_tokens",
          "enum": [
            "max_tokens",
            "max_completion_tokens"
          ],
          "title": "Max Tokens Field",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Model",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/OpenAIOptions"
        },
        "output_mode": {
          "enum": [
            "native",
            "tool"
          ],
          "title": "Output Mode",
          "type": "string"
        },
        "provider": {
          "const": "openai_compatible",
          "title": "Provider",
          "type": "string"
        },
        "queue_limit": {
          "default": 16,
          "maximum": 10000,
          "minimum": 0,
          "title": "Queue Limit",
          "type": "integer"
        },
        "request_timeout": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Request Timeout",
          "type": "number"
        },
        "supports_json_schema": {
          "default": true,
          "title": "Supports Json Schema",
          "type": "boolean"
        },
        "supports_text": {
          "default": true,
          "title": "Supports Text",
          "type": "boolean"
        },
        "supports_tools": {
          "default": true,
          "title": "Supports Tools",
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "output_mode",
        "provider",
        "base_url"
      ],
      "title": "CompatibleModelConfig",
      "type": "object"
    },
    "OpenAIModelConfig": {
      "additionalProperties": false,
      "properties": {
        "api": {
          "enum": [
            "chat",
            "responses"
          ],
          "title": "Api",
          "type": "string"
        },
        "api_key_env": {
          "default": "OPENAI_API_KEY",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Api Key Env",
          "type": "string"
        },
        "concurrency": {
          "default": 4,
          "maximum": 1024,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Model",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/OpenAIOptions"
        },
        "output_mode": {
          "enum": [
            "native",
            "tool"
          ],
          "title": "Output Mode",
          "type": "string"
        },
        "provider": {
          "const": "openai",
          "title": "Provider",
          "type": "string"
        },
        "queue_limit": {
          "default": 16,
          "maximum": 10000,
          "minimum": 0,
          "title": "Queue Limit",
          "type": "integer"
        },
        "request_timeout": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Request Timeout",
          "type": "number"
        },
        "supports_json_schema": {
          "default": true,
          "title": "Supports Json Schema",
          "type": "boolean"
        },
        "supports_text": {
          "default": true,
          "title": "Supports Text",
          "type": "boolean"
        },
        "supports_tools": {
          "default": true,
          "title": "Supports Tools",
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "output_mode",
        "provider",
        "api"
      ],
      "title": "OpenAIModelConfig",
      "type": "object"
    },
    "OpenAIOptions": {
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "default": 4096,
          "maximum": 1048576,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "OpenAIOptions",
      "type": "object"
    }
  },
  "$id": "https://foliqant.local/schemas/foliqant/runtime/model-profiles.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Named profiles have no reserved alias or implicit endpoint/model discovery.",
  "properties": {
    "models": {
      "maxProperties": 128,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {
          "discriminator": {
            "mapping": {
              "anthropic": "#/$defs/AnthropicModelConfig",
              "azure_openai": "#/$defs/AzureModelConfig",
              "openai": "#/$defs/OpenAIModelConfig",
              "openai_compatible": "#/$defs/CompatibleModelConfig"
            },
            "propertyName": "provider"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/OpenAIModelConfig"
            },
            {
              "$ref": "#/$defs/CompatibleModelConfig"
            },
            {
              "$ref": "#/$defs/AzureModelConfig"
            },
            {
              "$ref": "#/$defs/AnthropicModelConfig"
            }
          ]
        }
      },
      "title": "Models",
      "type": "object"
    }
  },
  "required": [
    "models"
  ],
  "title": "ModelProfiles",
  "type": "object"
}

{
  "$defs": {
    "Envelope": {
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "payload": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "payload"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "GoldCase": {
      "additionalProperties": false,
      "description": "Caller-authored input and assertions; no response is inferred as gold.",
      "properties": {
        "expectations": {
          "items": {
            "$ref": "#/$defs/GoldExpectation"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Expectations",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Id",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/Envelope"
        }
      },
      "required": [
        "id",
        "input",
        "expectations"
      ],
      "title": "GoldCase",
      "type": "object"
    },
    "GoldExpectation": {
      "additionalProperties": false,
      "description": "An explicit assertion over an ExecutionResult JSON pointer.",
      "properties": {
        "comparison": {
          "default": "exact",
          "enum": [
            "exact",
            "set"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/JsonValue"
        },
        "name": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "expected"
      ],
      "title": "GoldExpectation",
      "type": "object"
    },
    "IdentityId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f][^\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "Metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Open business metadata with closed, protected identity and trace fields.",
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/IdentityId",
          "title": "Principal Id"
        },
        "telemetry": {
          "$ref": "#/$defs/TraceCarrier",
          "title": "Telemetry"
        },
        "tenant_id": {
          "$ref": "#/$defs/IdentityId",
          "title": "Tenant Id"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "MetricConfig": {
      "additionalProperties": false,
      "description": "Optional metric over a declared, ordered category catalog.",
      "properties": {
        "kind": {
          "enum": [
            "classification",
            "multilabel"
          ],
          "title": "Kind",
          "type": "string"
        },
        "labels": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Labels",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "kind",
        "labels"
      ],
      "title": "MetricConfig",
      "type": "object"
    },
    "SuiteSpec": {
      "additionalProperties": false,
      "description": "A pipeline target, or one step with already-resolved step inputs.",
      "properties": {
        "cases": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/GoldCase"
              },
              "maxItems": 100000,
              "minItems": 1,
              "type": "array"
            },
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            }
          ],
          "title": "Cases"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricConfig"
          },
          "maxItems": 64,
          "title": "Metrics",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Name",
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "workflow": {
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "name",
        "workflow",
        "cases"
      ],
      "title": "SuiteSpec",
      "type": "object"
    },
    "TraceCarrier": {
      "additionalProperties": false,
      "description": "An incoming W3C carrier; the propagator decides whether it is valid.",
      "properties": {
        "traceparent": {
          "maxLength": 512,
          "title": "Traceparent",
          "type": "string"
        },
        "tracestate": {
          "maxLength": 512,
          "title": "Tracestate",
          "type": "string"
        }
      },
      "title": "TraceCarrier",
      "type": "object"
    }
  },
  "$id": "https://foliqant.local/schemas/foliqant/runtime/evaluation-dataset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned ground truth for configured pipeline and isolated-step evaluation.\n\nThe JSON file is independent of deployment dependencies. Loading and target\nchecks never resolve environment secrets, import user code or open SDKs.",
  "properties": {
    "name": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Name",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Revision",
      "type": "string"
    },
    "suites": {
      "items": {
        "$ref": "#/$defs/SuiteSpec"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Suites",
      "type": "array"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "name",
    "revision",
    "suites"
  ],
  "title": "EvaluationDataset",
  "type": "object"
}

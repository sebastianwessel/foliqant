{
  "$defs": {
    "IdentityId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f][^\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "Metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Open business metadata with closed, protected identity and trace fields.",
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/IdentityId",
          "title": "Principal Id"
        },
        "telemetry": {
          "$ref": "#/$defs/TraceCarrier",
          "title": "Telemetry"
        },
        "tenant_id": {
          "$ref": "#/$defs/IdentityId",
          "title": "Tenant Id"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "TraceCarrier": {
      "additionalProperties": false,
      "description": "An incoming W3C carrier; the propagator decides whether it is valid.",
      "properties": {
        "traceparent": {
          "maxLength": 512,
          "title": "Traceparent",
          "type": "string"
        },
        "tracestate": {
          "maxLength": 512,
          "title": "Tracestate",
          "type": "string"
        }
      },
      "title": "TraceCarrier",
      "type": "object"
    }
  },
  "$id": "https://foliqant.local/schemas/foliqant/runtime/envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "payload": {
      "$ref": "#/$defs/JsonValue"
    }
  },
  "required": [
    "payload"
  ],
  "title": "Envelope",
  "type": "object"
}

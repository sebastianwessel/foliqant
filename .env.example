# Local curation configuration. Copy to .env and adjust for your LM Studio server.
# .env is intentionally ignored and must not contain credentials for remote services.
FOLIQANT_CURATION_ENDPOINT_URL=http://127.0.0.1:1234/v1
FOLIQANT_CURATION_MODEL=twil-lm3
FOLIQANT_CURATION_STRUCTURED_OUTPUT=json-schema
FOLIQANT_CURATION_TIMEOUT_SECONDS=120
FOLIQANT_CURATION_MAX_TOKENS=2048
FOLIQANT_CURATION_TEMPERATURE=0.3
FOLIQANT_CURATION_MAX_CANDIDATES=100
FOLIQANT_CURATION_MAX_ATTEMPTS=2
FOLIQANT_CURATION_LANGUAGES=en

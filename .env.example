# Local curation configuration. Copy to .env and adjust for your standalone Splash server.
# .env is intentionally ignored. Local curation never uses remote-provider credentials.
FOLIQANT_CURATION_ENDPOINT_URL=http://127.0.0.1:8000/v1
FOLIQANT_CURATION_MODEL=incoai/Qwen3.8-27B-Splash
FOLIQANT_CURATION_REASONING_EFFORT=low
FOLIQANT_CURATION_STRUCTURED_OUTPUT=json-schema
# Set true only for a trusted RFC1918 or IPv6 unique-local model server.
FOLIQANT_CURATION_ALLOW_PRIVATE_NETWORK=false
FOLIQANT_CURATION_TIMEOUT_SECONDS=300
FOLIQANT_CURATION_MAX_TOKENS=8192
FOLIQANT_CURATION_TEMPERATURE=0.1
# Keep generation sizes/languages in the full and pilot YAML recipes.
# Optional FOLIQANT_CURATION_MAX_CANDIDATES/MAX_ATTEMPTS/LANGUAGES overrides
# affect BOTH recipes. An empty model requires exactly one discovered chat model.

{
  "$defs": {
    "CandidateAttemptTrace": {
      "additionalProperties": false,
      "description": "Immutable validation result for one bounded candidate attempt.",
      "properties": {
        "attempt": {
          "maximum": 5,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "calls": {
          "items": {
            "$ref": "#/$defs/CandidateCallTrace"
          },
          "maxItems": 3,
          "title": "Calls",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "quarantined"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "attempt",
        "status",
        "reason"
      ],
      "title": "CandidateAttemptTrace",
      "type": "object"
    },
    "CandidateCallTrace": {
      "additionalProperties": false,
      "description": "Bounded final-response evidence for one model call.",
      "properties": {
        "callId": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Callid",
          "type": "string"
        },
        "finalAssistantResponsePreview": {
          "anyOf": [
            {
              "maxLength": 32768,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finalassistantresponsepreview"
        },
        "phase": {
          "enum": [
            "generator",
            "checker",
            "rewrite",
            "solver"
          ],
          "title": "Phase",
          "type": "string"
        },
        "previewTruncated": {
          "default": false,
          "title": "Previewtruncated",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "requestSha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Requestsha256",
          "type": "string"
        },
        "responseSha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Responsesha256",
          "type": "string"
        },
        "responseSource": {
          "enum": [
            "endpoint-final",
            "canonical-output",
            "absent"
          ],
          "title": "Responsesource",
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "phase",
        "status",
        "reason",
        "callId",
        "requestSha256",
        "responseSha256",
        "responseSource"
      ],
      "title": "CandidateCallTrace",
      "type": "object"
    },
    "ChatMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "DataRecord": {
      "additionalProperties": false,
      "properties": {
        "familyId": {
          "$ref": "#/$defs/foliqant_model__contracts__base__Omitted_Annotated_str__StringConstraints____1",
          "default": null
        },
        "generation": {
          "$ref": "#/$defs/Omitted_GenerationProvenance_",
          "default": null
        },
        "groupKeys": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Groupkeys",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "language": {
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
          "title": "Language",
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "maxItems": 256,
          "minItems": 2,
          "title": "Messages",
          "type": "array"
        },
        "origin": {
          "enum": [
            "human",
            "synthetic",
            "teacher"
          ],
          "title": "Origin",
          "type": "string"
        },
        "reviewed": {
          "title": "Reviewed",
          "type": "boolean"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "sourceId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Sourceid",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "sourceId",
        "language",
        "groupKeys",
        "messages",
        "origin",
        "reviewed"
      ],
      "title": "DataRecord",
      "type": "object"
    },
    "GenerationProvenance": {
      "additionalProperties": false,
      "properties": {
        "modelId": {
          "minLength": 1,
          "title": "Modelid",
          "type": "string"
        },
        "modelIdentitySha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Modelidentitysha256",
          "type": "string"
        },
        "modelWeightsSha256": {
          "$ref": "#/$defs/foliqant_model__contracts__base__Omitted_Annotated_str__StringConstraints____2",
          "default": null
        },
        "parametersSha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parameterssha256",
          "type": "string"
        },
        "parentRecordIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Parentrecordids",
          "type": "array"
        },
        "promptSha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Promptsha256",
          "type": "string"
        },
        "provider": {
          "const": "openai-compatible",
          "title": "Provider",
          "type": "string"
        },
        "requestSha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Requestsha256",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "modelId",
        "modelIdentitySha256",
        "promptSha256",
        "parametersSha256",
        "requestSha256",
        "parentRecordIds"
      ],
      "title": "GenerationProvenance",
      "type": "object"
    },
    "Omitted_GenerationProvenance_": {
      "$ref": "#/$defs/GenerationProvenance"
    },
    "foliqant_model__contracts__base__Omitted_Annotated_str__StringConstraints____1": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "foliqant_model__contracts__base__Omitted_Annotated_str__StringConstraints____2": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://foliqant.local/schemas/model/candidate-outcome.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Persisted automatic decision and safe reason for one generated candidate.",
  "properties": {
    "attemptTrace": {
      "items": {
        "$ref": "#/$defs/CandidateAttemptTrace"
      },
      "maxItems": 5,
      "title": "Attempttrace",
      "type": "array"
    },
    "attempts": {
      "maximum": 5,
      "minimum": 1,
      "title": "Attempts",
      "type": "integer"
    },
    "jobId": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Jobid",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "record": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "requestSha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Requestsha256",
      "type": "string"
    },
    "responseSha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Responsesha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "quarantined"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "jobId",
    "status",
    "reason",
    "attempts",
    "requestSha256",
    "responseSha256",
    "record"
  ],
  "title": "CandidateOutcome",
  "type": "object"
}

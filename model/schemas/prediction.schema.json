{
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "Omitted_Literal__no-generated-tokens___": {
      "const": "no-generated-tokens",
      "type": "string"
    }
  },
  "$id": "https://foliqant.local/schemas/model/prediction.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicableValid": {
      "title": "Applicablevalid",
      "type": "boolean"
    },
    "componentId": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Componentid",
      "type": "string"
    },
    "elapsedSeconds": {
      "ge": 0,
      "title": "Elapsedseconds",
      "type": "number"
    },
    "evidenceValid": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Evidencevalid"
    },
    "exactCorrect": {
      "title": "Exactcorrect",
      "type": "boolean"
    },
    "expected": {
      "title": "Expected",
      "type": "string"
    },
    "expectedJson": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "fieldPresent": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Fieldpresent",
      "type": "object"
    },
    "fieldValid": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Fieldvalid",
      "type": "object"
    },
    "finishReason": {
      "enum": [
        "stop",
        "length"
      ],
      "title": "Finishreason",
      "type": "string"
    },
    "generated": {
      "title": "Generated",
      "type": "string"
    },
    "generatedJson": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "generatedTokens": {
      "minimum": 0,
      "title": "Generatedtokens",
      "type": "integer"
    },
    "groupIds": {
      "items": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Groupids",
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "jsonValid": {
      "title": "Jsonvalid",
      "type": "boolean"
    },
    "language": {
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "title": "Language",
      "type": "string"
    },
    "meanTokenLogprob": {
      "anyOf": [
        {
          "maximum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Meantokenlogprob"
    },
    "meanTokenLogprobUnavailableReason": {
      "$ref": "#/$defs/Omitted_Literal__no-generated-tokens___",
      "default": null
    },
    "representative": {
      "title": "Representative",
      "type": "boolean"
    },
    "schemaValid": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Schemavalid"
    },
    "sourceId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Sourceid",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "id",
    "sourceId",
    "language",
    "tags",
    "componentId",
    "groupIds",
    "representative",
    "expected",
    "generated",
    "expectedJson",
    "generatedJson",
    "elapsedSeconds",
    "generatedTokens",
    "meanTokenLogprob",
    "jsonValid",
    "finishReason",
    "schemaValid",
    "evidenceValid",
    "fieldPresent",
    "fieldValid",
    "applicableValid",
    "exactCorrect"
  ],
  "title": "Prediction",
  "type": "object"
}

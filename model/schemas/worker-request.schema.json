{
  "$defs": {
    "AdamwOptions": {
      "additionalProperties": false,
      "properties": {
        "weight_decay": {
          "const": 0,
          "title": "Weight Decay",
          "type": "integer"
        }
      },
      "required": [
        "weight_decay"
      ],
      "title": "AdamwOptions",
      "type": "object"
    },
    "ChatMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "DoctorWorkerRequest": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "doctor",
          "title": "Operation",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Requestid",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "operation"
      ],
      "title": "DoctorWorkerRequest",
      "type": "object"
    },
    "GenerateWorkerRequest": {
      "additionalProperties": false,
      "properties": {
        "adapterPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Adapterpath"
        },
        "maxTokens": {
          "maximum": 32768,
          "minimum": 1,
          "title": "Maxtokens",
          "type": "integer"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "maxItems": 255,
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        },
        "modelPath": {
          "title": "Modelpath",
          "type": "string"
        },
        "operation": {
          "const": "generate",
          "title": "Operation",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Requestid",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "temperature": {
          "const": 0,
          "title": "Temperature",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "operation",
        "modelPath",
        "adapterPath",
        "messages",
        "seed",
        "maxTokens",
        "temperature"
      ],
      "title": "GenerateWorkerRequest",
      "type": "object"
    },
    "GgufWorkerRequest": {
      "additionalProperties": false,
      "properties": {
        "modelPath": {
          "title": "Modelpath",
          "type": "string"
        },
        "operation": {
          "const": "gguf",
          "title": "Operation",
          "type": "string"
        },
        "outputPath": {
          "title": "Outputpath",
          "type": "string"
        },
        "outputPrecision": {
          "const": "F16",
          "title": "Outputprecision",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Requestid",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "operation",
        "modelPath",
        "outputPath",
        "outputPrecision"
      ],
      "title": "GgufWorkerRequest",
      "type": "object"
    },
    "MergeWorkerRequest": {
      "additionalProperties": false,
      "properties": {
        "adapterPath": {
          "title": "Adapterpath",
          "type": "string"
        },
        "dequantize": {
          "title": "Dequantize",
          "type": "boolean"
        },
        "modelPath": {
          "title": "Modelpath",
          "type": "string"
        },
        "operation": {
          "const": "merge",
          "title": "Operation",
          "type": "string"
        },
        "outputPath": {
          "title": "Outputpath",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Requestid",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "operation",
        "modelPath",
        "adapterPath",
        "outputPath",
        "dequantize"
      ],
      "title": "MergeWorkerRequest",
      "type": "object"
    },
    "MlxLoraParameters": {
      "additionalProperties": false,
      "properties": {
        "dropout": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Dropout",
          "type": "number"
        },
        "rank": {
          "maximum": 256,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "scale": {
          "exclusiveMinimum": 0,
          "maximum": 256,
          "title": "Scale",
          "type": "number"
        }
      },
      "required": [
        "rank",
        "scale",
        "dropout"
      ],
      "title": "MlxLoraParameters",
      "type": "object"
    },
    "MlxOptimizerConfig": {
      "additionalProperties": false,
      "properties": {
        "adamw": {
          "$ref": "#/$defs/AdamwOptions"
        }
      },
      "required": [
        "adamw"
      ],
      "title": "MlxOptimizerConfig",
      "type": "object"
    },
    "MlxTrainNamespace": {
      "additionalProperties": false,
      "properties": {
        "adapter_path": {
          "title": "Adapter Path",
          "type": "string"
        },
        "batch_size": {
          "maximum": 64,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "clear_cache_threshold": {
          "const": 0,
          "title": "Clear Cache Threshold",
          "type": "integer"
        },
        "config": {
          "title": "Config",
          "type": "null"
        },
        "data": {
          "title": "Data",
          "type": "string"
        },
        "fine_tune_type": {
          "const": "lora",
          "title": "Fine Tune Type",
          "type": "string"
        },
        "grad_accumulation_steps": {
          "maximum": 1024,
          "minimum": 1,
          "title": "Grad Accumulation Steps",
          "type": "integer"
        },
        "grad_checkpoint": {
          "title": "Grad Checkpoint",
          "type": "boolean"
        },
        "iters": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Iters",
          "type": "integer"
        },
        "learning_rate": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Learning Rate",
          "type": "number"
        },
        "lora_parameters": {
          "$ref": "#/$defs/MlxLoraParameters"
        },
        "lr_schedule": {
          "title": "Lr Schedule",
          "type": "null"
        },
        "mask_prompt": {
          "const": true,
          "title": "Mask Prompt",
          "type": "boolean"
        },
        "max_seq_length": {
          "maximum": 131072,
          "minimum": 64,
          "title": "Max Seq Length",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "num_layers": {
          "maximum": 1024,
          "minimum": -1,
          "title": "Num Layers",
          "type": "integer"
        },
        "optimizer": {
          "const": "adamw",
          "title": "Optimizer",
          "type": "string"
        },
        "optimizer_config": {
          "$ref": "#/$defs/MlxOptimizerConfig"
        },
        "project_name": {
          "title": "Project Name",
          "type": "null"
        },
        "report_to": {
          "title": "Report To",
          "type": "null"
        },
        "resume_adapter_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resume Adapter File"
        },
        "save_every": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Save Every",
          "type": "integer"
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "steps_per_eval": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Steps Per Eval",
          "type": "integer"
        },
        "steps_per_report": {
          "const": 1,
          "title": "Steps Per Report",
          "type": "integer"
        },
        "test": {
          "const": false,
          "title": "Test",
          "type": "boolean"
        },
        "test_batches": {
          "const": 500,
          "title": "Test Batches",
          "type": "integer"
        },
        "train": {
          "const": true,
          "title": "Train",
          "type": "boolean"
        },
        "val_batches": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Val Batches",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "data",
        "adapter_path",
        "resume_adapter_file",
        "train",
        "test",
        "fine_tune_type",
        "optimizer",
        "optimizer_config",
        "seed",
        "num_layers",
        "batch_size",
        "iters",
        "val_batches",
        "learning_rate",
        "steps_per_report",
        "steps_per_eval",
        "save_every",
        "test_batches",
        "max_seq_length",
        "config",
        "grad_checkpoint",
        "grad_accumulation_steps",
        "clear_cache_threshold",
        "lr_schedule",
        "report_to",
        "project_name",
        "lora_parameters",
        "mask_prompt"
      ],
      "title": "MlxTrainNamespace",
      "type": "object"
    },
    "QuantizeWorkerRequest": {
      "additionalProperties": false,
      "properties": {
        "bits": {
          "enum": [
            4,
            8
          ],
          "title": "Bits",
          "type": "integer"
        },
        "groupSize": {
          "const": 64,
          "title": "Groupsize",
          "type": "integer"
        },
        "mode": {
          "const": "affine",
          "title": "Mode",
          "type": "string"
        },
        "modelPath": {
          "title": "Modelpath",
          "type": "string"
        },
        "operation": {
          "const": "quantize",
          "title": "Operation",
          "type": "string"
        },
        "outputPath": {
          "title": "Outputpath",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Requestid",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "operation",
        "modelPath",
        "outputPath",
        "bits",
        "groupSize",
        "mode"
      ],
      "title": "QuantizeWorkerRequest",
      "type": "object"
    },
    "TrainWorkerRequest": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "$ref": "#/$defs/MlxTrainNamespace"
        },
        "operation": {
          "const": "train",
          "title": "Operation",
          "type": "string"
        },
        "outputPath": {
          "title": "Outputpath",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Requestid",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "trainPath": {
          "title": "Trainpath",
          "type": "string"
        },
        "validationPath": {
          "title": "Validationpath",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "operation",
        "namespace",
        "trainPath",
        "validationPath",
        "outputPath"
      ],
      "title": "TrainWorkerRequest",
      "type": "object"
    },
    "WorkerRequestValue": {
      "discriminator": {
        "mapping": {
          "doctor": "#/$defs/DoctorWorkerRequest",
          "generate": "#/$defs/GenerateWorkerRequest",
          "gguf": "#/$defs/GgufWorkerRequest",
          "merge": "#/$defs/MergeWorkerRequest",
          "quantize": "#/$defs/QuantizeWorkerRequest",
          "train": "#/$defs/TrainWorkerRequest"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DoctorWorkerRequest"
        },
        {
          "$ref": "#/$defs/TrainWorkerRequest"
        },
        {
          "$ref": "#/$defs/GenerateWorkerRequest"
        },
        {
          "$ref": "#/$defs/QuantizeWorkerRequest"
        },
        {
          "$ref": "#/$defs/MergeWorkerRequest"
        },
        {
          "$ref": "#/$defs/GgufWorkerRequest"
        }
      ]
    }
  },
  "$id": "https://foliqant.local/schemas/model/worker-request.schema.json",
  "$ref": "#/$defs/WorkerRequestValue",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkerRequest"
}

{
  "$defs": {
    "CliErrorCode": {
      "enum": [
        "ARGUMENT_INVALID",
        "CONFIG_INVALID",
        "CONFIG_TOO_LARGE",
        "CONFIG_DUPLICATE_KEY",
        "CONFIG_UNSUPPORTED_VERSION",
        "SCHEMA_DRIFT",
        "INPUT_NOT_FOUND",
        "OUTPUT_EXISTS",
        "DATA_RECORD_INVALID",
        "DATA_RIGHTS_DENIED",
        "DATA_DUPLICATE_ID",
        "DATA_DUPLICATE_CONVERSATION",
        "DATA_PARTITION_INVALID",
        "RISK_REPRESENTATIVE_MISSING",
        "RISK_SCORE_MISSING",
        "DEPENDENCY_MISSING",
        "ENVIRONMENT_UNSUPPORTED",
        "ARCHITECTURE_UNSUPPORTED",
        "BACKEND_FAILED",
        "IO_FAILED",
        "NETWORK_FAILED",
        "TIMEOUT",
        "OUTPUT_INVALID",
        "INTERNAL_ERROR",
        "INTEGRITY_FAILED",
        "UNSAFE_ARTIFACT_PATH",
        "LINEAGE_MISMATCH",
        "LEAKAGE_DETECTED",
        "PROFILE_MISMATCH",
        "SAMPLE_OVERLAP",
        "INTERRUPTED"
      ],
      "type": "string"
    },
    "Command": {
      "enum": [
        "doctor",
        "schema",
        "setup",
        "fetch",
        "prepare",
        "prepare-source-projections",
        "migrate-decisions",
        "upgrade-decision-data",
        "rerun-migrated-decisions",
        "curate",
        "quantize",
        "train",
        "customize",
        "evaluate",
        "calibrate",
        "audit",
        "merge",
        "export",
        "verify"
      ],
      "type": "string"
    },
    "ConfigIdentity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "dataset",
            "train",
            "evaluation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sha256"
      ],
      "title": "ConfigIdentity",
      "type": "object"
    },
    "RunFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/CliErrorCode"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "RunFailure",
      "type": "object"
    }
  },
  "$id": "https://foliqant.local/schemas/model/run-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "$ref": "#/$defs/Command"
    },
    "configuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConfigIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "datasetArtifactId": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Datasetartifactid"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunFailure"
        },
        {
          "type": "null"
        }
      ]
    },
    "finalizedArtifactId": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finalizedartifactid"
    },
    "logPath": {
      "title": "Logpath",
      "type": "string"
    },
    "parentArtifactIds": {
      "items": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Parentartifactids",
      "type": "array"
    },
    "pid": {
      "minimum": 1,
      "title": "Pid",
      "type": "integer"
    },
    "runId": {
      "maxLength": 32,
      "minLength": 32,
      "pattern": "^[0-9a-f]{12}4[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "title": "Runid",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "startedAt": {
      "title": "Startedat",
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "interrupted"
      ],
      "title": "Status",
      "type": "string"
    },
    "updatedAt": {
      "title": "Updatedat",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "command",
    "startedAt",
    "updatedAt",
    "status",
    "pid",
    "configuration",
    "parentArtifactIds",
    "datasetArtifactId",
    "failure",
    "logPath",
    "finalizedArtifactId"
  ],
  "title": "RunState",
  "type": "object"
}

#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if ! command -v uv >/dev/null 2>&1; then
  echo "Install uv first: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 3
fi
for argument in "$@"; do
  if [[ "$argument" == "--help" || "$argument" == "-h" ]]; then
    echo "Usage: ./scripts/curate-data [--config FILE] [--workspace DIR] [--repair-from RUN | --continue-from RUN | --extend-projections-from RUN --projection-plan DIR] [--prepare-only] [--offline] [--progress auto|always|never]"
    echo "Prepares pinned public sources and optionally uses one local OpenAI-compatible model."
    echo "Default config: model/examples/curation.yaml"
    echo "Default workspace: <repository>/.foliqant. Does not train a model."
    exit 0
  fi
done
forwarded=()
config_seen=false
while (( $# )); do
  case "$1" in
    --config|--workspace|--repair-from|--continue-from|--extend-projections-from|--projection-plan)
      option="$1"
      [[ "$option" == "--config" ]] && config_seen=true
      shift
      if (( $# == 0 )) || [[ -z "$1" ]]; then
        echo "$option requires a path" >&2
        exit 2
      fi
      path_value="$1"
      ;;
    --config=*|--workspace=*|--repair-from=*|--continue-from=*|--extend-projections-from=*|--projection-plan=*)
      option="${1%%=*}"
      [[ "$option" == "--config" ]] && config_seen=true
      path_value="${1#*=}"
      if [[ -z "$path_value" ]]; then
        echo "$option requires a path" >&2
        exit 2
      fi
      ;;
    *)
      forwarded+=("$1")
      shift
      continue
      ;;
  esac
  case "$path_value" in
    /*) ;;
    "~") path_value="$HOME" ;;
    "~/"*) path_value="$HOME/${path_value:2}" ;;
    *) path_value="$PWD/$path_value" ;;
  esac
  forwarded+=("$option" "$path_value")
  shift
done
if [[ "$config_seen" == false ]]; then
  forwarded=(--config "$repo_root/model/examples/curation.yaml" "${forwarded[@]+"${forwarded[@]}"}")
fi
cd -- "$repo_root"
sync_args=(sync --project "$repo_root/model" --locked --no-dev --inexact)
for argument in "${forwarded[@]+"${forwarded[@]}"}"; do
  if [[ "$argument" == "--offline" ]]; then
    sync_args+=(--offline)
  fi
done
uv "${sync_args[@]}"
runtime_python="$(uv run --project "$repo_root/model" --no-sync --locked python -c 'import sys; print(sys.executable)')"
if [[ ! -x "$runtime_python" ]]; then
  echo "The synchronized Foliqant environment has no Python executable" >&2
  exit 3
fi
exec "$runtime_python" -m foliqant_model curate "${forwarded[@]+"${forwarded[@]}"}"

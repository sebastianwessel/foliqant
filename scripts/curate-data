#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if ! command -v uv >/dev/null 2>&1; then
  echo "Install uv first: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 3
fi
load_environment() {
  local environment_file="$repo_root/.env"
  local line key value
  [[ -f "$environment_file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "${line:0:1}" == "#" ]] && continue
    [[ "$line" == *=* ]] || { echo ".env contains an invalid line" >&2; exit 2; }
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      FOLIQANT_CURATION_ENDPOINT_URL|FOLIQANT_CURATION_MODEL|FOLIQANT_CURATION_STRUCTURED_OUTPUT|FOLIQANT_CURATION_ALLOW_PRIVATE_NETWORK|FOLIQANT_CURATION_TIMEOUT_SECONDS|FOLIQANT_CURATION_MAX_TOKENS|FOLIQANT_CURATION_TEMPERATURE|FOLIQANT_CURATION_MAX_RESPONSE_BYTES|FOLIQANT_CURATION_MAX_CANDIDATES|FOLIQANT_CURATION_MAX_ATTEMPTS|FOLIQANT_CURATION_LANGUAGES|FOLIQANT_CURATION_SCENARIO_FAMILIES|FOLIQANT_CURATION_MAX_INPUT_CHARACTERS)
        export "$key=$value"
        ;;
      *) echo ".env contains an unsupported configuration key" >&2; exit 2 ;;
    esac
  done < "$environment_file"
}
load_environment
for argument in "$@"; do
  if [[ "$argument" == "--help" || "$argument" == "-h" ]]; then
    echo "Usage: ./scripts/curate-data [--config FILE] [--workspace DIR] [--prepare-only] [--offline]"
    echo "Prepares pinned public sources and optionally uses one local LM Studio model."
    echo "Default config: model/examples/curation.yaml"
    echo "Default workspace: ~/.local/share/foliqant. Does not train a model."
    exit 0
  fi
done
forwarded=()
config_seen=false
while (( $# )); do
  case "$1" in
    --config|--workspace)
      option="$1"
      [[ "$option" == "--config" ]] && config_seen=true
      shift
      if (( $# == 0 )) || [[ -z "$1" ]]; then
        echo "$option requires a path" >&2
        exit 2
      fi
      path_value="$1"
      ;;
    --config=*|--workspace=*)
      option="${1%%=*}"
      [[ "$option" == "--config" ]] && config_seen=true
      path_value="${1#*=}"
      if [[ -z "$path_value" ]]; then
        echo "$option requires a path" >&2
        exit 2
      fi
      ;;
    *)
      forwarded+=("$1")
      shift
      continue
      ;;
  esac
  case "$path_value" in
    /*) ;;
    "~") path_value="$HOME" ;;
    "~/"*) path_value="$HOME/${path_value:2}" ;;
    *) path_value="$PWD/$path_value" ;;
  esac
  forwarded+=("$option" "$path_value")
  shift
done
if [[ "$config_seen" == false ]]; then
  forwarded=(--config "$repo_root/model/examples/curation.yaml" "${forwarded[@]+"${forwarded[@]}"}")
fi
cd -- "$repo_root"
sync_args=(sync --locked --no-dev --inexact)
for argument in "${forwarded[@]+"${forwarded[@]}"}"; do
  if [[ "$argument" == "--offline" ]]; then
    sync_args+=(--offline)
  fi
done
uv "${sync_args[@]}"
exec uv run --no-sync --locked foliqant-model curate "${forwarded[@]+"${forwarded[@]}"}"

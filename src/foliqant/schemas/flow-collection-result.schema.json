{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "invalid_configuration",
        "invalid_input",
        "invalid_output",
        "unauthenticated",
        "forbidden",
        "not_found",
        "missing_binding",
        "timeout",
        "budget_exhausted",
        "dependency_failure",
        "conflict",
        "uncertain_effect",
        "cancelled",
        "capacity_exceeded"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "FlowAttempt": {
      "additionalProperties": false,
      "description": "One attempt of a repeated flow, or one run of a retry flow.",
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "completed"
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "needs_review"
            }
          }
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "failed"
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "cancelled"
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "result"
                ]
              },
              {
                "required": [
                  "error"
                ]
              }
            ]
          },
          "properties": {
            "status": {
              "const": "skipped"
            }
          }
        }
      ],
      "properties": {
        "attempt": {
          "maximum": 64,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        },
        "error": {
          "$ref": "#/$defs/SafeError",
          "title": "Error"
        },
        "result": {
          "$ref": "#/$defs/JsonValue"
        },
        "status": {
          "$ref": "#/$defs/StepStatus"
        },
        "steps": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {
              "$ref": "#/$defs/StepResult"
            }
          },
          "title": "Steps",
          "type": "object"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "steps",
        "attempt"
      ],
      "title": "FlowAttempt",
      "type": "object"
    },
    "FlowCollectionItemResult": {
      "additionalProperties": false,
      "description": "One collection item's complete flow record, including skipped local steps.\n\nA callable flow with ``repeat`` carries its attempts like a routed flow;\n``retry`` records the item's retry flow runs (last run plus ``attempts``).",
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "completed"
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "needs_review"
            }
          }
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "failed"
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "cancelled"
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "result"
                ]
              },
              {
                "required": [
                  "error"
                ]
              }
            ]
          },
          "properties": {
            "status": {
              "const": "skipped"
            }
          }
        }
      ],
      "properties": {
        "attempt_count": {
          "maximum": 64,
          "minimum": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/FlowAttempt"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Attempts",
          "type": "array"
        },
        "attempts_elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempts Elapsed Seconds"
        },
        "attempts_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        },
        "error": {
          "$ref": "#/$defs/SafeError",
          "title": "Error"
        },
        "flow": {
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Flow",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "repeat": {
          "$ref": "#/$defs/RepeatInfo",
          "title": "Repeat"
        },
        "result": {
          "$ref": "#/$defs/JsonValue"
        },
        "retry": {
          "$ref": "#/$defs/FlowResult",
          "title": "Retry"
        },
        "status": {
          "$ref": "#/$defs/StepStatus"
        },
        "steps": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {
              "$ref": "#/$defs/StepResult"
            }
          },
          "title": "Steps",
          "type": "object"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "steps",
        "attempt_count",
        "id",
        "flow"
      ],
      "title": "FlowCollectionItemResult",
      "type": "object"
    },
    "FlowCollectionResult": {
      "additionalProperties": false,
      "description": "Ordered child invocation ledger; each item identity occurs exactly once.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/FlowCollectionItemResult"
          },
          "maxItems": 1024,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "FlowCollectionResult",
      "type": "object"
    },
    "FlowResult": {
      "additionalProperties": false,
      "description": "A flow's scoped step records and explicitly present projected result.\n\n``attempt_count`` counts executions (zero when skipped). Repeated and retry\nflows list every run in ``attempts``; the top-level fields describe the last\nrun and ``attempts_usage`` / ``attempts_elapsed_seconds`` sum all runs.",
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "completed"
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "needs_review"
            }
          }
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "failed"
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "cancelled"
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "result"
                ]
              },
              {
                "required": [
                  "error"
                ]
              }
            ]
          },
          "properties": {
            "status": {
              "const": "skipped"
            }
          }
        }
      ],
      "properties": {
        "attempt_count": {
          "maximum": 64,
          "minimum": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/FlowAttempt"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Attempts",
          "type": "array"
        },
        "attempts_elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempts Elapsed Seconds"
        },
        "attempts_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        },
        "error": {
          "$ref": "#/$defs/SafeError",
          "title": "Error"
        },
        "repeat": {
          "$ref": "#/$defs/RepeatInfo",
          "title": "Repeat"
        },
        "result": {
          "$ref": "#/$defs/JsonValue"
        },
        "status": {
          "$ref": "#/$defs/StepStatus"
        },
        "steps": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {
              "$ref": "#/$defs/StepResult"
            }
          },
          "title": "Steps",
          "type": "object"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "steps",
        "attempt_count"
      ],
      "title": "FlowResult",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ModelUsage": {
      "additionalProperties": false,
      "description": "Usage of one provider model ID; ``null`` counts were not reported.",
      "properties": {
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cached Input Tokens"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost"
        },
        "cost_complete": {
          "title": "Cost Complete",
          "type": "boolean"
        },
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Tokens"
        },
        "reference_model": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Reference Model",
          "type": "string"
        },
        "requests": {
          "minimum": 1,
          "title": "Requests",
          "type": "integer"
        }
      },
      "required": [
        "requests",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_tokens"
      ],
      "title": "ModelUsage",
      "type": "object"
    },
    "RepeatInfo": {
      "additionalProperties": false,
      "description": "Why a repeated flow stopped; exhaustion is not a review.",
      "properties": {
        "stopped_by": {
          "enum": [
            "until",
            "exhausted",
            "continue_when",
            "review",
            "failure"
          ],
          "title": "Stopped By",
          "type": "string"
        }
      },
      "required": [
        "stopped_by"
      ],
      "title": "RepeatInfo",
      "type": "object"
    },
    "SafeError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "location": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Location",
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "SafeError",
      "type": "object"
    },
    "SelectedCategory": {
      "additionalProperties": false,
      "description": "Exact configured category identity; descriptions retain authored whitespace.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "SelectedCategory",
      "type": "object"
    },
    "StepResult": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "partial_result"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "flow_collection"
              },
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "needs_review"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/FlowCollectionResult",
                "title": "Partial Result"
              }
            },
            "required": [
              "result"
            ]
          }
        },
        {
          "if": {
            "required": [
              "selection"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "needs_review"
                ]
              }
            },
            "required": [
              "result"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "completed"
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "needs_review"
            }
          }
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "failed"
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "cancelled"
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "result"
                ]
              },
              {
                "required": [
                  "error"
                ]
              }
            ]
          },
          "properties": {
            "status": {
              "const": "skipped"
            }
          }
        }
      ],
      "properties": {
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        },
        "error": {
          "$ref": "#/$defs/SafeError",
          "title": "Error"
        },
        "kind": {
          "const": "flow_collection",
          "title": "Kind",
          "type": "string"
        },
        "partial_result": {
          "$ref": "#/$defs/FlowCollectionResult",
          "title": "Partial Result"
        },
        "result": {
          "$ref": "#/$defs/JsonValue"
        },
        "selection": {
          "$ref": "#/$defs/StepSelection",
          "title": "Selection"
        },
        "status": {
          "$ref": "#/$defs/StepStatus"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "StepResult",
      "type": "object"
    },
    "StepSelection": {
      "additionalProperties": false,
      "description": "Effective classification without changing the native answer or uncertainty.",
      "properties": {
        "category": {
          "$ref": "#/$defs/SelectedCategory"
        },
        "origin": {
          "enum": [
            "model",
            "fallback"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "category",
        "origin"
      ],
      "title": "StepSelection",
      "type": "object"
    },
    "StepStatus": {
      "enum": [
        "completed",
        "needs_review",
        "failed",
        "cancelled",
        "skipped"
      ],
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Measured totals; ``by_model`` splits model requests by provider model ID.\n\n``by_model`` is omitted when no model request was made; when present it\naccounts for every model request. Cost fields sum the priced models and are\nomitted when no model is priced.",
      "properties": {
        "by_model": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelUsage"
          },
          "minProperties": 1,
          "propertyNames": {
            "maxLength": 512,
            "minLength": 1
          },
          "title": "By Model",
          "type": "object"
        },
        "cache_read_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cache Read Input Tokens"
        },
        "cache_write_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cache Write Input Tokens"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost"
        },
        "cost_complete": {
          "title": "Cost Complete",
          "type": "boolean"
        },
        "currency": {
          "const": "USD",
          "title": "Currency",
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "model_requests": {
          "minimum": 0,
          "title": "Model Requests",
          "type": "integer"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "reasoning_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Output Tokens"
        },
        "reference_model": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Reference Model",
          "type": "string"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "model_requests",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_write_input_tokens",
        "reasoning_output_tokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "$id": "urn:foliqant:schema:flow-collection-result.schema.json",
  "$ref": "#/$defs/FlowCollectionResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

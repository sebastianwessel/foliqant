{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "invalid_configuration",
        "invalid_input",
        "invalid_output",
        "unauthenticated",
        "forbidden",
        "not_found",
        "missing_binding",
        "timeout",
        "budget_exhausted",
        "dependency_failure",
        "conflict",
        "uncertain_effect",
        "cancelled",
        "capacity_exceeded"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "FlowCollectionItemResult": {
      "additionalProperties": false,
      "description": "One collection item's complete flow record, including skipped local steps.",
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "completed"
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "needs_review"
            }
          }
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "failed"
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "cancelled"
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "result"
                ]
              },
              {
                "required": [
                  "error"
                ]
              }
            ]
          },
          "properties": {
            "status": {
              "const": "skipped"
            }
          }
        }
      ],
      "properties": {
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        },
        "error": {
          "$ref": "#/$defs/SafeError",
          "title": "Error"
        },
        "flow": {
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Flow",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/JsonValue"
        },
        "status": {
          "$ref": "#/$defs/StepStatus"
        },
        "steps": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {
              "$ref": "#/$defs/StepResult"
            }
          },
          "title": "Steps",
          "type": "object"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "steps",
        "id",
        "flow"
      ],
      "title": "FlowCollectionItemResult",
      "type": "object"
    },
    "FlowCollectionResult": {
      "additionalProperties": false,
      "description": "Ordered child invocation ledger; each item identity occurs exactly once.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/FlowCollectionItemResult"
          },
          "maxItems": 1024,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "FlowCollectionResult",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "SafeError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "location": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Location",
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "SafeError",
      "type": "object"
    },
    "SelectedCategory": {
      "additionalProperties": false,
      "description": "Exact configured category identity; descriptions retain authored whitespace.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "SelectedCategory",
      "type": "object"
    },
    "StepResult": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "partial_result"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "flow_collection"
              },
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "needs_review"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/FlowCollectionResult",
                "title": "Partial Result"
              }
            },
            "required": [
              "result"
            ]
          }
        },
        {
          "if": {
            "required": [
              "selection"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "needs_review"
                ]
              }
            },
            "required": [
              "result"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "completed"
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "needs_review"
            }
          }
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "failed"
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "cancelled"
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "result"
                ]
              },
              {
                "required": [
                  "error"
                ]
              }
            ]
          },
          "properties": {
            "status": {
              "const": "skipped"
            }
          }
        }
      ],
      "properties": {
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        },
        "error": {
          "$ref": "#/$defs/SafeError",
          "title": "Error"
        },
        "kind": {
          "const": "flow_collection",
          "title": "Kind",
          "type": "string"
        },
        "partial_result": {
          "$ref": "#/$defs/FlowCollectionResult",
          "title": "Partial Result"
        },
        "result": {
          "$ref": "#/$defs/JsonValue"
        },
        "selection": {
          "$ref": "#/$defs/StepSelection",
          "title": "Selection"
        },
        "status": {
          "$ref": "#/$defs/StepStatus"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "StepResult",
      "type": "object"
    },
    "StepSelection": {
      "additionalProperties": false,
      "description": "Effective classification without changing the native answer or uncertainty.",
      "properties": {
        "category": {
          "$ref": "#/$defs/SelectedCategory"
        },
        "origin": {
          "enum": [
            "model",
            "fallback"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "category",
        "origin"
      ],
      "title": "StepSelection",
      "type": "object"
    },
    "StepStatus": {
      "enum": [
        "completed",
        "needs_review",
        "failed",
        "cancelled",
        "skipped"
      ],
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cache_read_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cache Read Input Tokens"
        },
        "cache_write_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cache Write Input Tokens"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "model_requests": {
          "minimum": 0,
          "title": "Model Requests",
          "type": "integer"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "reasoning_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Output Tokens"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "model_requests",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_write_input_tokens",
        "reasoning_output_tokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "$id": "urn:foliqant:schema:flow-collection-result.schema.json",
  "$ref": "#/$defs/FlowCollectionResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

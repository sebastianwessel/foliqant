{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "invalid_configuration",
        "invalid_input",
        "invalid_output",
        "unauthenticated",
        "forbidden",
        "not_found",
        "missing_binding",
        "timeout",
        "budget_exhausted",
        "dependency_failure",
        "conflict",
        "uncertain_effect",
        "cancelled",
        "capacity_exceeded"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ExecutionInfo": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "status": {
              "enum": [
                "failed",
                "cancelled"
              ]
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "enum": [
                "completed",
                "needs_review"
              ]
            }
          }
        }
      ],
      "properties": {
        "error": {
          "$ref": "#/$defs/SafeError",
          "title": "Error"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Revision",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "workflow": {
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "id",
        "workflow",
        "revision",
        "status",
        "usage"
      ],
      "title": "ExecutionInfo",
      "type": "object"
    },
    "FlowResult": {
      "additionalProperties": false,
      "description": "A flow's scoped step records and explicitly present projected result.",
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "completed"
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "needs_review"
            }
          }
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "failed"
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "cancelled"
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "result"
                ]
              },
              {
                "required": [
                  "error"
                ]
              }
            ]
          },
          "properties": {
            "status": {
              "const": "skipped"
            }
          }
        }
      ],
      "properties": {
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        },
        "error": {
          "$ref": "#/$defs/SafeError",
          "title": "Error"
        },
        "result": {
          "$ref": "#/$defs/JsonValue"
        },
        "status": {
          "$ref": "#/$defs/StepStatus"
        },
        "steps": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {
              "$ref": "#/$defs/StepResult"
            }
          },
          "title": "Steps",
          "type": "object"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "steps"
      ],
      "title": "FlowResult",
      "type": "object"
    },
    "IdentityId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f][^\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "Metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Open business metadata with closed, protected identity and trace fields.",
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/IdentityId",
          "title": "Principal Id"
        },
        "telemetry": {
          "$ref": "#/$defs/TraceCarrier",
          "title": "Telemetry"
        },
        "tenant_id": {
          "$ref": "#/$defs/IdentityId",
          "title": "Tenant Id"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "completed",
        "needs_review",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "SafeError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "location": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Location",
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "SafeError",
      "type": "object"
    },
    "SelectedCategory": {
      "additionalProperties": false,
      "description": "Exact configured category identity; descriptions retain authored whitespace.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "SelectedCategory",
      "type": "object"
    },
    "StepResult": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "selection"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "needs_review"
                ]
              }
            },
            "required": [
              "result"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "completed"
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "status": {
              "const": "needs_review"
            }
          }
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "failed"
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "status": {
              "const": "cancelled"
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "result"
                ]
              },
              {
                "required": [
                  "error"
                ]
              }
            ]
          },
          "properties": {
            "status": {
              "const": "skipped"
            }
          }
        }
      ],
      "properties": {
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        },
        "error": {
          "$ref": "#/$defs/SafeError",
          "title": "Error"
        },
        "result": {
          "$ref": "#/$defs/JsonValue"
        },
        "selection": {
          "$ref": "#/$defs/StepSelection",
          "title": "Selection"
        },
        "status": {
          "$ref": "#/$defs/StepStatus"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "StepResult",
      "type": "object"
    },
    "StepSelection": {
      "additionalProperties": false,
      "description": "Effective classification without changing the native answer or uncertainty.",
      "properties": {
        "category": {
          "$ref": "#/$defs/SelectedCategory"
        },
        "origin": {
          "enum": [
            "model",
            "fallback"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "category",
        "origin"
      ],
      "title": "StepSelection",
      "type": "object"
    },
    "StepStatus": {
      "enum": [
        "completed",
        "needs_review",
        "failed",
        "cancelled",
        "skipped"
      ],
      "type": "string"
    },
    "TraceCarrier": {
      "additionalProperties": false,
      "description": "An incoming W3C carrier; the propagator decides whether it is valid.",
      "properties": {
        "traceparent": {
          "maxLength": 512,
          "title": "Traceparent",
          "type": "string"
        },
        "tracestate": {
          "maxLength": 512,
          "title": "Tracestate",
          "type": "string"
        }
      },
      "title": "TraceCarrier",
      "type": "object"
    },
    "TransitionResult": {
      "additionalProperties": false,
      "description": "One recorded workflow boundary with exactly one authored target.",
      "oneOf": [
        {
          "not": {
            "required": [
              "outcome"
            ]
          },
          "required": [
            "flow"
          ]
        },
        {
          "not": {
            "required": [
              "flow"
            ]
          },
          "required": [
            "outcome"
          ]
        }
      ],
      "properties": {
        "flow": {
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Flow",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "completed",
            "needs_review"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "enum": [
            "completed",
            "needs_review"
          ],
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "reason"
      ],
      "title": "TransitionResult",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cache_read_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cache Read Input Tokens"
        },
        "cache_write_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cache Write Input Tokens"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "model_requests": {
          "minimum": 0,
          "title": "Model Requests",
          "type": "integer"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "reasoning_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Output Tokens"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "model_requests",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_write_input_tokens",
        "reasoning_output_tokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "$id": "urn:foliqant:schema:execution-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "execution": {
      "$ref": "#/$defs/ExecutionInfo"
    },
    "flows": {
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {
          "$ref": "#/$defs/FlowResult"
        }
      },
      "title": "Flows",
      "type": "object"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "payload": {
      "$ref": "#/$defs/JsonValue"
    },
    "transitions": {
      "items": {
        "$ref": "#/$defs/TransitionResult"
      },
      "title": "Transitions",
      "type": "array"
    }
  },
  "required": [
    "payload",
    "metadata",
    "flows",
    "transitions",
    "execution"
  ],
  "title": "ExecutionResult",
  "type": "object"
}

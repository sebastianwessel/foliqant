    "DeclaredTool": {
      "additionalProperties": false,
      "description": "Operator-reviewed tool metadata used by offline compilation only.",
      "properties": {
        "effect": {
          "enum": [
            "read",
            "write"
          ],
          "title": "Effect",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Input Schema",
          "type": "object"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        }
      },
      "required": [
        "input_schema",
        "effect"
      ],
      "title": "DeclaredTool",
      "type": "object"
    },
    "DeclaredToolCatalog": {
      "additionalProperties": false,
      "properties": {
        "tools": {
          "additionalProperties": {
            "$ref": "#/$defs/DeclaredTool"
          },
          "title": "Tools",
          "type": "object"
        }
      },
      "required": [
        "tools"
      ],
      "title": "DeclaredToolCatalog",
      "type": "object"
    },
    "EvaluationConfig": {
      "additionalProperties": false,
      "description": "Optional gold dataset reference, opened only by evaluation commands.\n\nRelative paths are based on the deployment file. The dataset may be omitted\nfrom production deployments even when this reference remains configured.",
      "properties": {
        "dataset": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Dataset",
          "type": "string"
        }
      },
      "required": [
        "dataset"
      ],
      "title": "EvaluationConfig",
      "type": "object"
    },
    "ExecutionConfig": {
      "additionalProperties": false,
      "description": "Per-replica admission and per-run attempt/time bounds.",
      "properties": {
        "concurrency": {
          "default": 4,
          "maximum": 1024,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "max_steps": {
          "default": 32,
          "maximum": 1024,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "model_requests_per_step": {
          "default": 4,
          "maximum": 1024,
          "minimum": 1,
          "title": "Model Requests Per Step",
          "type": "integer"
        },
        "model_timeout": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Model Timeout",
          "type": "number"
        },
        "queue_limit": {
          "default": 16,
          "maximum": 65536,
          "minimum": 0,
          "title": "Queue Limit",
          "type": "integer"
        },
        "run_timeout": {
          "default": 300.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Run Timeout",
          "type": "number"
        },
        "tool_calls_per_step": {
          "default": 3,
          "maximum": 1024,
          "minimum": 1,
          "title": "Tool Calls Per Step",
          "type": "integer"
        },
        "tool_timeout": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Tool Timeout",
          "type": "number"
        }
      },
      "title": "ExecutionConfig",
      "type": "object"
    },
    "GenerationOptions": {
      "additionalProperties": false,
      "description": "Common sampling options; absence means use the configured provider default.",
      "properties": {
        "max_tokens": {
          "default": 4096,
          "maximum": 1048576,

{
  "$defs": {
    "AnthropicModelConfig": {
      "additionalProperties": false,
      "properties": {
        "api_key": {
          "environment_reference": true,
          "format": "password",
          "title": "Api Key",
          "type": "string",
          "writeOnly": true
        },
        "concurrency": {
          "default": 4,
          "maximum": 1024,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "model": {
          "environment_reference": true,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/AnthropicOptions"
        },
        "output_mode": {
          "enum": [
            "native",
            "tool"
          ],
          "title": "Output Mode",
          "type": "string"
        },
        "provider": {
          "const": "anthropic",
          "title": "Provider",
          "type": "string"
        },
        "queue_limit": {
          "default": 16,
          "maximum": 10000,
          "minimum": 0,
          "title": "Queue Limit",
          "type": "integer"
        },
        "request_timeout": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Request Timeout",
          "type": "number"
        },
        "retry": {
          "$ref": "#/$defs/RetryConfig"
        },
        "supports_json_schema": {
          "default": true,
          "title": "Supports Json Schema",
          "type": "boolean"
        },
        "supports_text": {
          "default": true,
          "title": "Supports Text",
          "type": "boolean"
        },
        "supports_tools": {
          "default": true,
          "title": "Supports Tools",
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "output_mode",
        "provider"
      ],
      "title": "AnthropicModelConfig",
      "type": "object"
    },
    "AnthropicOptions": {
      "additionalProperties": false,
      "properties": {
        "effort": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "max_tokens": {
          "default": 4096,
          "maximum": 1048576,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "thinking": {
          "anyOf": [
            {
              "enum": [
                "disabled",
                "adaptive"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking"
        },
        "thinking_budget": {
          "anyOf": [
            {
              "minimum": 1024,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Budget"
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "AnthropicOptions",
      "type": "object"
    },

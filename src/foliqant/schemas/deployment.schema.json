    },
    "HandlerDeclaration": {
      "additionalProperties": false,
      "description": "The reviewed contract of one trusted handler; the host registers the callable.\n\nSchemas are inline objects or JSON/YAML files relative to the settings file,\nconfined to its directory. Declarations let offline commands validate\nworkflows without importing host code.",
      "properties": {
        "effect": {
          "enum": [
            "read",
            "write"
          ],
          "title": "Effect",
          "type": "string"
        },
        "input_schema": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            }
          ],
          "title": "Input Schema"
        },
        "output_schema": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            }
          ],
          "title": "Output Schema"
        }
      },
      "required": [
        "input_schema",
        "output_schema",
        "effect"
      ],
      "title": "HandlerDeclaration",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "McpHttpTransport": {
      "additionalProperties": false,
      "description": "Current Streamable HTTP endpoint; HTTPS is the deployment default.",
      "properties": {
        "allow_insecure_http": {
          "default": false,
          "title": "Allow Insecure Http",
          "type": "boolean"
        },
        "endpoint": {
          "environment_reference": true,
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "type": {
          "const": "streamable_http",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "endpoint"
      ],
      "title": "McpHttpTransport",
      "type": "object"
    },
    "McpServerProfile": {
      "additionalProperties": false,
      "description": "One trusted server binding and its operator-reviewed host policy.",
      "properties": {
        "auth": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auth"
        },
        "catalog": {
          "$ref": "#/$defs/DeclaredToolCatalog"
        },
        "concurrency": {
          "default": 4,
          "maximum": 1024,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "identity_meta_key": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 5,
              "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}/[A-Za-z0-9](?:[A-Za-z0-9._~/-]*[A-Za-z0-9._~-])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Meta Key"
        },
        "output_limit_bytes": {
          "default": 1048576,
          "maximum": 67108864,
          "minimum": 1,
          "title": "Output Limit Bytes",
          "type": "integer"
        },
        "queue_limit": {
          "default": 16,
          "maximum": 10000,
          "minimum": 0,
          "title": "Queue Limit",
          "type": "integer"
        },
        "request_timeout": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Request Timeout",
          "type": "number"
        },
        "retry": {
          "$ref": "#/$defs/RetryConfig"
        },
        "transport": {
          "discriminator": {
            "mapping": {
              "stdio": "#/$defs/McpStdioTransport",
              "streamable_http": "#/$defs/McpHttpTransport"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/McpHttpTransport"
            },
            {
              "$ref": "#/$defs/McpStdioTransport"
            }
          ],
          "title": "Transport"
        }
      },
      "required": [
        "transport",
        "catalog"
      ],
      "title": "McpServerProfile",
      "type": "object"
    },
    "McpStdioTransport": {
      "additionalProperties": false,
      "description": "Trusted child settings plus an overlay on the SDK's fixed safe environment.",
      "properties": {
        "args": {
          "environment_reference": true,
          "items": {
            "maxLength": 8192,
            "type": "string"
          },
          "maxItems": 256,
          "title": "Args",
          "type": "array"
        },
        "command": {
          "environment_reference": true,
          "maxLength": 4096,
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "cwd": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "environment_reference": true,
          "title": "Cwd"
        },
        "env": {
          "environment_reference": true,
          "maxProperties": 128,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "format": "password",
              "type": "string",
              "writeOnly": true
            }
          },
          "title": "Env",
          "type": "object"
        },
        "type": {
          "const": "stdio",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "command"
      ],
      "title": "McpStdioTransport",
      "type": "object"
    },
    "OpenAIModelConfig": {
      "additionalProperties": false,
      "properties": {
        "api": {
          "enum": [
            "chat",
            "responses"
          ],
          "title": "Api",
          "type": "string"
        },
        "api_key": {
          "environment_reference": true,
          "format": "password",
          "title": "Api Key",
          "type": "string",
          "writeOnly": true
        },
        "concurrency": {
          "default": 4,
          "maximum": 1024,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "model": {
          "environment_reference": true,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/OpenAIOptions"
        },
        "output_mode": {
          "enum": [
            "native",
            "tool"
          ],
          "title": "Output Mode",
          "type": "string"
        },
        "provider": {
          "const": "openai",
          "title": "Provider",
          "type": "string"
        },
        "queue_limit": {
          "default": 16,
          "maximum": 10000,
          "minimum": 0,
          "title": "Queue Limit",
          "type": "integer"
        },
        "request_timeout": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Request Timeout",
          "type": "number"
        },
        "retry": {
          "$ref": "#/$defs/RetryConfig"
        },
        "supports_json_schema": {
          "default": true,
          "title": "Supports Json Schema",
          "type": "boolean"
        },
        "supports_text": {
          "default": true,
          "title": "Supports Text",
          "type": "boolean"
        },
        "supports_tools": {
          "default": true,
          "title": "Supports Tools",
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "output_mode",
        "provider",
        "api"
      ],
      "title": "OpenAIModelConfig",
      "type": "object"
    },
    "OpenAIOptions": {
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "default": 4096,
          "maximum": 1048576,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "OpenAIOptions",
      "type": "object"
    },
    "RetryConfig": {
      "additionalProperties": false,
      "description": "Retries are disabled by default; max_attempts includes the first request.",
      "properties": {
        "initial_delay_seconds": {
          "default": 0.25,
          "maximum": 60,
          "minimum": 0,
          "title": "Initial Delay Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 1,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_delay_seconds": {
          "default": 5.0,
          "maximum": 300,
          "minimum": 0,
          "title": "Max Delay Seconds",
          "type": "number"
        }
      },
      "title": "RetryConfig",
      "type": "object"
    },
    "TelemetryConfig": {
      "additionalProperties": false,
      "description": "Explicit OTLP/HTTP settings; secret header contents are redacted on export.",
      "properties": {
        "allow_insecure_http": {
          "default": false,
          "title": "Allow Insecure Http",
          "type": "boolean"
        },
        "conditions": {
          "default": false,
          "title": "Conditions",
          "type": "boolean"
        },
        "export_timeout": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Export Timeout",
          "type": "number"
        },
        "metric_export_batch_size": {
          "default": 512,
          "maximum": 65536,
          "minimum": 1,
          "title": "Metric Export Batch Size",
          "type": "integer"
        },
        "metric_export_interval": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Metric Export Interval",
          "type": "number"
        },
        "metrics_endpoint": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "environment_reference": true,
          "title": "Metrics Endpoint"
        },
        "metrics_headers": {
          "environment_reference": true,
          "maxProperties": 64,
          "patternProperties": {
            "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$": {
              "format": "password",
              "type": "string",
              "writeOnly": true
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Metrics Headers",
          "type": "object"
        },
        "service_name": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Service Name",
          "type": "string"
        },
        "shutdown_timeout": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Shutdown Timeout",
          "type": "number"
        },
        "span_batch_size": {
          "default": 512,
          "maximum": 4096,
          "minimum": 1,
          "title": "Span Batch Size",
          "type": "integer"
        },
        "span_queue_capacity": {
          "default": 2048,
          "maximum": 65536,
          "minimum": 1,
          "title": "Span Queue Capacity",
          "type": "integer"
        },
        "span_schedule_delay": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Span Schedule Delay",
          "type": "number"
        },
        "traces_endpoint": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "environment_reference": true,
          "title": "Traces Endpoint"
        },
        "traces_headers": {
          "environment_reference": true,
          "maxProperties": 64,
          "patternProperties": {
            "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$": {
              "format": "password",
              "type": "string",
              "writeOnly": true
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Traces Headers",
          "type": "object"
        }
      },
      "required": [
        "service_name"
      ],
      "title": "TelemetryConfig",
      "type": "object"
    }
  },
  "$id": "urn:foliqant:schema:deployment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Configuration contains references and policy, never resolved credentials.",
  "properties": {
    "evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution": {
      "$ref": "#/$defs/ExecutionConfig"
    },
    "handlers": {
      "maxProperties": 256,
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {
          "$ref": "#/$defs/HandlerDeclaration"
        }
      },
      "title": "Handlers",
      "type": "object"
    },
    "mcp": {
      "maxProperties": 128,
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {
          "$ref": "#/$defs/McpServerProfile"
        }
      },
      "title": "Mcp",
      "type": "object"
    },
    "models": {
      "maxProperties": 128,
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {
          "discriminator": {
            "mapping": {
              "anthropic": "#/$defs/AnthropicModelConfig",
              "azure_openai": "#/$defs/AzureModelConfig",
              "bedrock": "#/$defs/BedrockModelConfig",
              "google": "#/$defs/GoogleModelConfig",
              "openai": "#/$defs/OpenAIModelConfig",
              "openai_compatible": "#/$defs/CompatibleModelConfig"
            },
            "propertyName": "provider"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/OpenAIModelConfig"
            },
            {
              "$ref": "#/$defs/CompatibleModelConfig"
            },
            {
              "$ref": "#/$defs/AzureModelConfig"
            },
            {
              "$ref": "#/$defs/AnthropicModelConfig"
            },
            {
              "$ref": "#/$defs/GoogleModelConfig"
            },
            {
              "$ref": "#/$defs/BedrockModelConfig"
            }
          ]
        }
      },
      "title": "Models",
      "type": "object"
    },
    "telemetry": {
      "anyOf": [
        {
          "$ref": "#/$defs/TelemetryConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workflows": {
      "anyOf": [
        {
          "maxProperties": 64,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflows"
    }
  },
  "title": "DeploymentConfig",
  "type": "object"
}

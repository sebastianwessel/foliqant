          "default": 1,
          "maximum": 8,
          "minimum": 0,
          "title": "Output Retries",
          "type": "integer"
        },
        "pricing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelPricing"
            },
            {
              "type": "null"
            }
          ],

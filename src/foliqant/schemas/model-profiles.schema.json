    "AnthropicModelConfig": {
      "additionalProperties": false,
      "properties": {
        "api_key": {
          "environment_reference": true,
          "format": "password",
          "title": "Api Key",
          "type": "string",
          "writeOnly": true
        },
        "concurrency": {
          "default": 4,
          "maximum": 1024,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"

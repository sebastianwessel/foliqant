{
  "$defs": {
    "Answerability": {
      "additionalProperties": false,
      "properties": {
        "issues": {
          "items": {
            "$ref": "#/$defs/AnswerabilityIssue"
          },
          "maxItems": 3,
          "title": "Issues",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/AnswerabilityStatus"
        }
      },
      "required": [
        "status",
        "issues"
      ],
      "title": "Answerability",
      "type": "object"
    },
    "AnswerabilityIssue": {
      "enum": [
        "no_supported_answer",
        "conflicting_information",
        "multiple_valid_options"
      ],
      "type": "string"
    },
    "AnswerabilityStatus": {
      "enum": [
        "answerable",
        "partially_answerable",
        "not_answerable",
        "undetermined"
      ],
      "type": "string"
    },
    "ChoiceAnswer": {
      "additionalProperties": false,
      "properties": {
        "optionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Optionid",
          "type": "string"
        }
      },
      "required": [
        "optionId"
      ],
      "title": "ChoiceAnswer",
      "type": "object"
    },
    "ChoiceResult": {
      "additionalProperties": false,
      "description": "One selected option or an explained abstention, with assessment support.",
      "properties": {
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChoiceAnswer"
            },
            {
              "type": "null"
            }
          ]
        },
        "answerability": {
          "$ref": "#/$defs/Answerability"
        },
        "evidence_strength": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceStrength"
            },
            {
              "type": "null"
            }
          ],
          "description": "Support for the whole reported assessment, including answerability and any abstention. Strong or limited may accompany any answerability status. Null means support was not assessed; it does not mean the answer is absent. This is not model confidence or a correctness probability."
        },
        "questionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Questionid",
          "type": "string"
        },
        "reason": {
          "maxLength": 400,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "type": {
          "const": "choice",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "questionId",
        "answerability",
        "reason",
        "evidence_strength",
        "type",
        "answer"
      ],
      "title": "ChoiceResult",
      "type": "object"
    },
    "ConditionalRelation": {
      "additionalProperties": false,
      "properties": {
        "predicateQuestionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Predicatequestionid",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Requestid",
          "type": "string"
        },
        "requiredValue": {
          "enum": [
            "true",
            "false"
          ],
          "title": "Requiredvalue",
          "type": "string"
        },
        "type": {
          "const": "conditional_on",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "predicateQuestionId",
        "requiredValue"
      ],
      "title": "ConditionalRelation",
      "type": "object"
    },
    "DecisionResult": {
      "discriminator": {
        "mapping": {
          "choice": "#/$defs/ChoiceResult",
          "multiselect": "#/$defs/MultiselectResult",
          "ordinal": "#/$defs/OrdinalResult",
          "predicate": "#/$defs/PredicateResult",
          "request_units": "#/$defs/RequestUnitsResult"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ChoiceResult"
        },
        {
          "$ref": "#/$defs/MultiselectResult"
        },
        {
          "$ref": "#/$defs/PredicateResult"
        },
        {
          "$ref": "#/$defs/OrdinalResult"
        },
        {
          "$ref": "#/$defs/RequestUnitsResult"
        }
      ]
    },
    "EvidenceStrength": {
      "enum": [
        "limited",
        "strong"
      ],
      "type": "string"
    },
    "MultiselectAnswer": {
      "additionalProperties": false,
      "properties": {
        "optionIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Optionids",
          "type": "array"
        }
      },
      "required": [
        "optionIds"
      ],
      "title": "MultiselectAnswer",
      "type": "object"
    },
    "MultiselectResult": {
      "additionalProperties": false,
      "description": "Selected options; strength covers the collection and its answerability.",
      "properties": {
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/MultiselectAnswer"
            },
            {
              "type": "null"
            }
          ]
        },
        "answerability": {
          "$ref": "#/$defs/Answerability"
        },
        "evidence_strength": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceStrength"
            },
            {
              "type": "null"
            }
          ],
          "description": "Support for the whole reported assessment, including answerability and any abstention. Strong or limited may accompany any answerability status. Null means support was not assessed; it does not mean the answer is absent. This is not model confidence or a correctness probability."
        },
        "questionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Questionid",
          "type": "string"
        },
        "reason": {
          "maxLength": 400,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "type": {
          "const": "multiselect",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "questionId",
        "answerability",
        "reason",
        "evidence_strength",
        "type",
        "answer"
      ],
      "title": "MultiselectResult",
      "type": "object"
    },
    "MutuallyExclusiveRelation": {
      "additionalProperties": false,
      "properties": {
        "requestIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Requestids",
          "type": "array"
        },
        "type": {
          "const": "mutually_exclusive",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestIds"
      ],
      "title": "MutuallyExclusiveRelation",
      "type": "object"
    },
    "OrdinalAnswer": {
      "additionalProperties": false,
      "properties": {
        "levelId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Levelid",
          "type": "string"
        }
      },
      "required": [
        "levelId"
      ],
      "title": "OrdinalAnswer",
      "type": "object"
    },
    "OrdinalResult": {
      "additionalProperties": false,
      "description": "One rubric level or an explained abstention, with assessment support.",
      "properties": {
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrdinalAnswer"
            },
            {
              "type": "null"
            }
          ]
        },
        "answerability": {
          "$ref": "#/$defs/Answerability"
        },
        "evidence_strength": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceStrength"
            },
            {
              "type": "null"
            }
          ],
          "description": "Support for the whole reported assessment, including answerability and any abstention. Strong or limited may accompany any answerability status. Null means support was not assessed; it does not mean the answer is absent. This is not model confidence or a correctness probability."
        },
        "questionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Questionid",
          "type": "string"
        },
        "reason": {
          "maxLength": 400,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "type": {
          "const": "ordinal",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "questionId",
        "answerability",
        "reason",
        "evidence_strength",
        "type",
        "answer"
      ],
      "title": "OrdinalResult",
      "type": "object"
    },
    "PrecedesRelation": {
      "additionalProperties": false,
      "properties": {
        "afterRequestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Afterrequestid",
          "type": "string"
        },
        "beforeRequestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Beforerequestid",
          "type": "string"
        },
        "type": {
          "const": "precedes",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "beforeRequestId",
        "afterRequestId"
      ],
      "title": "PrecedesRelation",
      "type": "object"
    },
    "PredicateResult": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "A true/false answer or unknown, with support for the whole assessment.",
          "properties": {
            "answer": {
              "additionalProperties": false,
              "properties": {
                "value": {
                  "enum": [
                    "true",
                    "false"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "title": "PredicateAnswer",
              "type": "object"
            },
            "answerability": {
              "additionalProperties": false,
              "properties": {
                "issues": {
                  "items": {
                    "$ref": "#/$defs/AnswerabilityIssue"
                  },
                  "maxItems": 3,
                  "title": "Issues",
                  "type": "array"
                },
                "status": {
                  "enum": [
                    "answerable"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "status",
                "issues"
              ],
              "title": "Answerability",
              "type": "object"
            },
            "evidence_strength": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EvidenceStrength"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Support for the whole reported assessment, including answerability and any abstention. Strong or limited may accompany any answerability status. Null means support was not assessed; it does not mean the answer is absent. This is not model confidence or a correctness probability."
            },
            "questionId": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "title": "Questionid",
              "type": "string"
            },
            "reason": {
              "maxLength": 400,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Reason",
              "type": "string"
            },
            "type": {
              "const": "predicate",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "questionId",
            "answerability",
            "reason",
            "evidence_strength",
            "type",
            "answer"
          ],
          "title": "PredicateResult",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A true/false answer or unknown, with support for the whole assessment.",
          "properties": {
            "answer": {
              "additionalProperties": false,
              "properties": {
                "value": {
                  "enum": [
                    "unknown"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "title": "PredicateAnswer",
              "type": "object"
            },
            "answerability": {
              "additionalProperties": false,
              "properties": {
                "issues": {
                  "items": {
                    "$ref": "#/$defs/AnswerabilityIssue"
                  },
                  "maxItems": 3,
                  "minItems": 1,
                  "title": "Issues",
                  "type": "array"
                },
                "status": {
                  "enum": [
                    "not_answerable",
                    "undetermined"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "status",
                "issues"
              ],
              "title": "Answerability",
              "type": "object"
            },
            "evidence_strength": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EvidenceStrength"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Support for the whole reported assessment, including answerability and any abstention. Strong or limited may accompany any answerability status. Null means support was not assessed; it does not mean the answer is absent. This is not model confidence or a correctness probability."
            },
            "questionId": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "title": "Questionid",
              "type": "string"
            },
            "reason": {
              "maxLength": 400,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Reason",
              "type": "string"
            },
            "type": {
              "const": "predicate",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "questionId",
            "answerability",
            "reason",
            "evidence_strength",
            "type",
            "answer"
          ],
          "title": "PredicateResult",
          "type": "object"
        }
      ]
    },
    "RequestRelation": {
      "discriminator": {
        "mapping": {
          "conditional_on": "#/$defs/ConditionalRelation",
          "mutually_exclusive": "#/$defs/MutuallyExclusiveRelation",
          "precedes": "#/$defs/PrecedesRelation",
          "requires": "#/$defs/RequiresRelation"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ConditionalRelation"
        },
        {
          "$ref": "#/$defs/RequiresRelation"
        },
        {
          "$ref": "#/$defs/PrecedesRelation"
        },
        {
          "$ref": "#/$defs/MutuallyExclusiveRelation"
        }
      ]
    },
    "RequestUnit": {
      "additionalProperties": false,
      "description": "One requested item; identifiers are local to this response.",
      "properties": {
        "categoryId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Categoryid"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "withdrawn",
            "conditional",
            "quoted"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject"
        }
      },
      "required": [
        "id",
        "status",
        "categoryId",
        "subject",
        "description"
      ],
      "title": "RequestUnit",
      "type": "object"
    },
    "RequestUnitsAnswer": {
      "additionalProperties": false,
      "description": "Requested items and their explicitly supported relationships.",
      "properties": {
        "relations": {
          "items": {
            "$ref": "#/$defs/RequestRelation"
          },
          "maxItems": 256,
          "title": "Relations",
          "type": "array"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/RequestUnit"
          },
          "maxItems": 256,
          "title": "Units",
          "type": "array"
        }
      },
      "required": [
        "units",
        "relations"
      ],
      "title": "RequestUnitsAnswer",
      "type": "object"
    },
    "RequestUnitsResult": {
      "additionalProperties": false,
      "description": "Request collection with support for the reported items and answerability.",
      "properties": {
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestUnitsAnswer"
            },
            {
              "type": "null"
            }
          ]
        },
        "answerability": {
          "$ref": "#/$defs/Answerability"
        },
        "evidence_strength": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceStrength"
            },
            {
              "type": "null"
            }
          ],
          "description": "Support for the whole reported assessment, including answerability and any abstention. Strong or limited may accompany any answerability status. Null means support was not assessed; it does not mean the answer is absent. This is not model confidence or a correctness probability."
        },
        "questionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Questionid",
          "type": "string"
        },
        "reason": {
          "maxLength": 400,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "type": {
          "const": "request_units",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "questionId",
        "answerability",
        "reason",
        "evidence_strength",
        "type",
        "answer"
      ],
      "title": "RequestUnitsResult",
      "type": "object"
    },
    "RequiresRelation": {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Requestid",
          "type": "string"
        },
        "requiredRequestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Requiredrequestid",
          "type": "string"
        },
        "type": {
          "const": "requires",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "requiredRequestId"
      ],
      "title": "RequiresRelation",
      "type": "object"
    }
  },
  "$id": "urn:foliqant:schema:decision-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed output for configured questions and sources.\n\n``evidence_strength`` is required; null means support was not assessed.\nRatings cover the whole assessment, including justified abstentions, and do\nnot override answerability, catalog membership, or configured routing.",
  "properties": {
    "results": {
      "items": {
        "$ref": "#/$defs/DecisionResult"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Results",
      "type": "array"
    }
  },
  "required": [
    "results"
  ],
  "title": "DecisionOutput",
  "type": "object"
}
